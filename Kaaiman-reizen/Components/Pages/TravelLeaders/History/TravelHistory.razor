@page "/travelleaders/history"
@attribute [Authorize(Roles = "Reisleider")]
@rendermode InteractiveServer

<PageTitle>Mijn Reisgeschiedenis</PageTitle>

<h1 class="h4">Mijn Reisgeschiedenis</h1>

<div class="card">
    <div class="card-body">
        @if (_loading)
        {
            <div class="text-muted">Gegevens laden...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <AlertModal IsOpen="true"
                        Title="Reisgeschiedenis"
                        Severity="Severity.Info"
                        Message="@_statusMessage" />
        }
        else
        {
            @if (_journeys.Count == 0)
            {
                <div class="text-muted">Nog geen reizen in je geschiedenis.</div>
            }
            else
            {
                <div class="table-responsive app-table-scroll">
                    <table class="table app-table mb-0">
                        <thead>
                            <tr>
                                <th>Reis</th>
                                <th>Start</th>
                                <th>Eind</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var journey in _journeys)
                            {
                                <tr>
                                    <td>@journey.Name</td>
                                    <td>@DateDisplay.FormatDate(journey.Start)</td>
                                    <td>@DateDisplay.FormatDate(journey.End)</td>
                                    <td>@GetBookingStatusBadge((int)journey.BookingStatus)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>