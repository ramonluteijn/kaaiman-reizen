@page "/travelleaders/preferences"
@page "/travelleaders/preferences/{Id:int}"
@rendermode InteractiveServer
@using Kaaiman_reizen.Data.Entities
@using Kaaiman_reizen.Data.Enum
@using Kaaiman_reizen.Data.Services
@using Kaaiman_reizen.Helpers
@using MudBlazor

<PageTitle>Mijn Voorkeuren</PageTitle>

<h1 class="h4 d-flex align-items-center gap-2">Mijn Reisvoorkeuren
    <Tooltip>
        <strong>Reisvoorkeuren — hoe werkt dit?</strong>
        <ul>
            <li>Stel hier uw profiel in: aantal reizen, min/max per jaar en een notitie.</li>
            <li>Vul per planningsronde uw voorkeuren in via de kaarten bovenaan.</li>
            <li>Klik op "Opslaan" om uw profiel te bewaren.</li>
        </ul>
    </Tooltip>
</h1>
<p class="text-muted">Geef hier je voorkeuren door voor de komende reizen.</p>

@if (_loading)
{
    <div>Bezig met laden…</div>
}
else if (_notFound)
{
    <div class="text-muted">Reisleider niet gevonden.</div>
}
else
{
    @* ── Planningsrondes sectie ── *@
    @if (_participations.Any())
    {
        <div class="mb-4">
            <h5>Planningsrondes</h5>

            @if (!string.IsNullOrEmpty(_roundSuccessMessage))
            {
                <div class="alert alert-success py-2 mb-3">@_roundSuccessMessage</div>
            }

            @foreach (var participation in _participations)
            {
                var round = participation.PlanningRound;
                var isExpanded = _expandedParticipationId == participation.Id;
                var isSubmitted = participation.Status == ParticipationStatus.Submitted;
                var isUnavailable = participation.Status == ParticipationStatus.Unavailable;

                <div class="card mb-2">
                    <div class="card-body py-3">

                        @* Header rij *@
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="fw-semibold">@round.Name</span>
                                <span class="text-muted ms-2 small">
                                    @round.StartDate.ToString("d MMM") – @round.EndDate.ToString("d MMM yyyy")
                                </span>
                                <span class="@GetDeadlineClass(round.PreferenceDeadline) ms-2 small">
                                    @GetDeadlineLabel(round.PreferenceDeadline)
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (isUnavailable && !isExpanded)
                                {
                                    <span class="badge bg-secondary">Afgemeld</span>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="@(() => ExpandRound(participation, _journeys))">
                                        Aanpassen
                                    </MudButton>
                                }
                                else if (isSubmitted && !isExpanded)
                                {
                                    <span class="badge bg-success">Ingediend ✓</span>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="@(() => ExpandRound(participation, _journeys))">
                                        Aanpassen
                                    </MudButton>
                                }
                                else if (!isExpanded)
                                {
                                    <span class="badge bg-warning text-dark">Nog niet ingediend</span>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               OnClick="@(() => ExpandRound(participation, _journeys))">
                                        Voorkeuren invullen
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CollapseRound">
                                        Sluiten
                                    </MudButton>
                                }
                            </div>
                        </div>

                        @* Uitklapbaar formulier *@
                        @if (isExpanded)
                        {
                            <hr class="mt-3 mb-3" />

                            @* Niet beschikbaar checkbox *@
                            <div class="form-check mb-3 p-3 border rounded @(_roundFullyUnavailable ? "border-secondary bg-light" : "border-light")">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="unavail_@participation.Id"
                                       checked="@_roundFullyUnavailable"
                                       @onchange="@(e => _roundFullyUnavailable = (bool)e.Value!)" />
                                <label class="form-check-label fw-semibold" for="unavail_@participation.Id">
                                    Ik ben niet beschikbaar voor alle reizen in deze periode
                                </label>
                                @if (_roundFullyUnavailable)
                                {
                                    <div class="text-muted small mt-1">De planner ziet dat je je beschikbaarheid hebt ingevuld en niet kunt.</div>
                                }
                            </div>

                            @if (!_roundFullyUnavailable)
                            {
                                @if (_journeysForRound.Count == 0)
                                {
                                    <p class="text-muted small fst-italic">Geen actieve reizen gevonden in de datumreeks van deze ronde.</p>
                                }
                                else
                                {
                                    <h6 class="mt-2">Top 3 voorkeursreizen</h6>
                                    <p class="text-muted small">Selecteer maximaal 3 reizen die je het liefst begeleidt (keuze 1 = sterkste voorkeur).</p>

                                    <div class="mb-3">
                                        <label class="form-label">Keuze 1</label>
                                        <select class="form-select" @onchange="@(e => SetRoundPreference(0, e))">
                                            <option value="">— Geen voorkeur —</option>
                                            @foreach (var j in _journeysForRound)
                                            {
                                                var picked = _roundPreferredJourneyIds[1] == j.Id || _roundPreferredJourneyIds[2] == j.Id;
                                                <option value="@j.Id" disabled="@picked" selected="@(_roundPreferredJourneyIds[0] == j.Id)">
                                                    @j.Name (@DateDisplay.FormatDateRange(j.Start, j.End))
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Keuze 2</label>
                                        <select class="form-select" @onchange="@(e => SetRoundPreference(1, e))">
                                            <option value="">— Geen voorkeur —</option>
                                            @foreach (var j in _journeysForRound)
                                            {
                                                var picked = _roundPreferredJourneyIds[0] == j.Id || _roundPreferredJourneyIds[2] == j.Id;
                                                <option value="@j.Id" disabled="@picked" selected="@(_roundPreferredJourneyIds[1] == j.Id)">
                                                    @j.Name (@DateDisplay.FormatDateRange(j.Start, j.End))
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Keuze 3</label>
                                        <select class="form-select" @onchange="@(e => SetRoundPreference(2, e))">
                                            <option value="">— Geen voorkeur —</option>
                                            @foreach (var j in _journeysForRound)
                                            {
                                                var picked = _roundPreferredJourneyIds[0] == j.Id || _roundPreferredJourneyIds[1] == j.Id;
                                                <option value="@j.Id" disabled="@picked" selected="@(_roundPreferredJourneyIds[2] == j.Id)">
                                                    @j.Name (@DateDisplay.FormatDateRange(j.Start, j.End))
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <h6 class="mt-4">Ook beschikbaar voor</h6>
                                    <p class="text-muted small">Vink de reizen aan waarvoor je beschikbaar bent, ook als ze niet in je top 3 staan.</p>
                                    <div class="mb-3">
                                        @foreach (var j in _journeysForRound)
                                        {
                                            var jid = j.Id;
                                            var inTop3 = _roundPreferredJourneyIds[0] == jid
                                                      || _roundPreferredJourneyIds[1] == jid
                                                      || _roundPreferredJourneyIds[2] == jid;
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="ravail_@(participation.Id)_@jid"
                                                       disabled="@inTop3"
                                                       checked="@(_roundAvailableJourneyIds.Contains(jid) || inTop3)"
                                                       @onchange="@(e => ToggleRoundAvailable(jid, (bool)e.Value!))" />
                                                <label class="form-check-label @(inTop3 ? "text-muted" : "")"
                                                       for="ravail_@(participation.Id)_@jid">
                                                    @j.Name (@DateDisplay.FormatDateRange(j.Start, j.End))
                                                    @if (inTop3)
                                                    {
                                                        <span class="badge bg-primary ms-1">Top 3</span>
                                                    }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            <div class="d-flex gap-2 mt-3">
                                <MudButton Variant="Variant.Filled"
                                           Color="@(_roundFullyUnavailable ? Color.Default : Color.Primary)"
                                           StartIcon="@(_roundFullyUnavailable ? Icons.Material.Filled.Block : Icons.Material.Filled.Send)"
                                           Disabled="_submittingRound"
                                           OnClick="@(() => HandleRoundSubmit(participation.Id))">
                                    @if (_submittingRound)
                                    {
                                        <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
                                    }
                                    @(_roundFullyUnavailable ? "Afmelden" : "Indienen")
                                </MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CollapseRound" Disabled="_submittingRound">
                                    Annuleren
                                </MudButton>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    }

    @* ── Profiel & globale voorkeuren ── *@
    <div class="card">
        <div class="card-body">
            <EditForm Model="_profileForm" OnValidSubmit="HandleSubmit" FormName="PreferencesForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Aantal reizen gereisd</label>
                    <InputNumber class="form-control" @bind-Value="_profileForm.AmountOfTrips" />
                    <ValidationMessage For="() => _profileForm.AmountOfTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Minimaal aantal reizen per jaar</label>
                    <InputNumber class="form-control" @bind-Value="_profileForm.MinTrips" />
                    <ValidationMessage For="() => _profileForm.MinTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Maximaal aantal reizen per jaar</label>
                    <InputNumber class="form-control" @bind-Value="_profileForm.MaxTrips" />
                    <ValidationMessage For="() => _profileForm.MaxTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Notitie</label>
                    <InputTextArea class="form-control" @bind-Value="_profileForm.Note" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="_profileForm.IsActive" />
                    <label class="form-check-label">Actief</label>
                </div>

                @if (!string.IsNullOrEmpty(_profileSuccessMessage))
                {
                    <div class="alert alert-success py-2 mb-3">@_profileSuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(_profileErrorMessage))
                {
                    <div class="alert alert-danger py-2 mb-3">@_profileErrorMessage</div>
                }

                <div class="app-form-actions">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="_isSaving">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Bezig met opslaan...</MudText>
                        }
                        else
                        {
                            <MudText>Opslaan</MudText>
                        }
                    </MudButton>
                </div>
            </EditForm>
        </div>
    </div>
}
