@page "/travelleaders/preferences"
@page "/travelleaders/preferences/{Id:int}"
@rendermode InteractiveServer
@using Kaaiman_reizen.Data.Entities
@using Kaaiman_reizen.Data.Services
@using MudBlazor

<PageTitle>Mijn Voorkeuren</PageTitle>

<h1 class="h4">Mijn Reisvoorkeuren en Beschikbaarheid</h1>
<p class="text-muted">Geef hier je voorkeuren en beschikbaarheid door voor de komende reizen.</p>

<div class="card">
    <div class="card-body">
        @if (_loading)
        {
            <div>Bezig met laden…</div>
        }
        else if (_notFound)
        {
            <div class="text-muted">Reisleider niet gevonden.</div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" FormName="PreferencesForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Aantal reizen gereisd</label>
                    <InputNumber class="form-control" @bind-Value="_model.AmountOfTrips" />
                    <ValidationMessage For="() => _model.AmountOfTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Minimaal aantal reizen per jaar</label>
                    <InputNumber class="form-control" @bind-Value="_model.MinTrips" />
                    <ValidationMessage For="() => _model.MinTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Maximaal aantal reizen per jaar</label>
                    <InputNumber class="form-control" @bind-Value="_model.MaxTrips" />
                    <ValidationMessage For="() => _model.MaxTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Notitie</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Note" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.IsActive" />
                    <label class="form-check-label">Actief</label>
                </div>

                <h5>Top 3 voorkeursreizen</h5>
                <p class="text-muted small">Selecteer maximaal 3 reizen die je het liefst begeleidt (keuze 1 = sterkste voorkeur).</p>
                @for (int rank = 0; rank < 3; rank++)
                {
                    var r = rank;
                    <div class="mb-3">
                        <label class="form-label">Keuze @(r + 1)</label>
                        @if (_journeys.Count == 0)
                        {
                            <p class="text-muted small fst-italic">Er zijn momenteel geen actieve reizen beschikbaar.</p>
                        }
                        else
                        {
                            <InputSelect class="form-select" @bind-Value="_preferredJourneyIds[r]">
                                <option value="">— Geen voorkeur —</option>
                                @foreach (var j in _journeys)
                                {
                                    var alreadyPicked = _preferredJourneyIds
                                        .Where((_, idx) => idx != r)
                                        .Any(id => id == j.Id);
                                    <option value="@j.Id" disabled="@alreadyPicked">
                                        @j.Name (@j.Start.ToString("dd-MM-yyyy") t/m @j.End.ToString("dd-MM-yyyy"))
                                    </option>
                                }
                            </InputSelect>
                        }
                    </div>
                }

                @if (_journeys.Count > 0)
                {
                    <h5 class="mt-4">Ook beschikbaar voor</h5>
                    <p class="text-muted small">Vink de reizen aan waarvoor je beschikbaar bent, ook als ze niet in je top 3 staan.</p>
                    <div class="mb-3">
                        @foreach (var j in _journeys)
                        {
                            var jid = j.Id;
                            var inTop3 = _preferredJourneyIds.Any(id => id == jid);
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="avail_@jid"
                                       disabled="@inTop3"
                                       checked="@(_availableJourneyIds.Contains(jid) || inTop3)"
                                       @onchange="@(e => ToggleAvailable(jid, (bool)e.Value!))" />
                                <label class="form-check-label @(inTop3 ? "text-muted" : "")" for="avail_@jid">
                                    @j.Name (@j.Start.ToString("dd-MM-yyyy") t/m @j.End.ToString("dd-MM-yyyy"))
                                    @if (inTop3) { <span class="badge bg-primary ms-1">Top 3</span> }
                                </label>
                            </div>
                        }
                    </div>
                }

                <h5>Beschikbaarheid (periode)</h5>
                @for (int i = 0; i < _preferredPeriods.Count; i++)
                {
                    var period = _preferredPeriods[i];
                    var idx = i;
                    <div class="app-period-row mb-2">
                        <div>
                            <label class="form-label">Start</label>
                            <InputDate @bind-Value="period.Start" class="form-control" />
                        </div>
                        <div>
                            <label class="form-label">Eind</label>
                            <InputDate @bind-Value="period.End" class="form-control" />
                        </div>
                        <div class="app-period-action">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(EventCallback.Factory.Create(this, () => RemovePeriod(idx)))">
                                Verwijderen
                            </MudButton>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddPeriod">
                        Periode toevoegen
                    </MudButton>
                </div>

                    <div class="app-form-actions">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save">
                        Opslaan
                    </MudButton>
                </div>
            </EditForm>
        }
    </div>
</div>
