@page "/travelleaders"
@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer
@using Kaaiman_reizen.Models.ViewModels
@using Kaaiman_reizen.Data.Services
@using Kaaiman_reizen.Data.Entities
@inject IJSRuntime JS

<PageTitle>Reisleiders</PageTitle>

<h1 class="h4">Reisleiders</h1>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <input class="form-control"
                   placeholder="Zoek op naam..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
        </div>

            <Table TItem="TravelLeaderViewModel" Items="FilteredLeaders" OnDelete="@OnDelete" Path="travelleaders" CreateText="Nieuwe reisleider" EditHrefSelector="@GetEditHref">
            <HeaderContent>
                <th @onclick='() => SortBy("Name")'>
                    Naam @(GetSortIcon("Name"))
                </th>
                <th>Telefoon</th>
                <th @onclick='() => SortBy("Experience")'>
                    Reizen Ervaring @(GetSortIcon("Experience"))
                </th>
                <th @onclick='() => SortBy("Minimum")'>
                    Minimaal Aantal Reizen @(GetSortIcon("Minimum"))
                </th>
                <th @onclick='() => SortBy("Maximum")'>
                    Maximaal Aantal Reizen @(GetSortIcon("Maximum"))
                </th>
                <th>Beschikbaar</th>
                <th @onclick='() => SortBy("Active")'>
                    Actief @(GetSortIcon("Active"))
                </th>
            </HeaderContent>
            <RowTemplate>
                <td>@context.Name</td>
                <td>@context.PhoneNumber</td>
                <td>@context.AmountOfTrips</td>
                <td>@context.MinTrips</td>
                <td>@context.MaxTrips</td>
                <td>@context.Availability</td>
                <td>
                    <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")" style="cursor: pointer;" @onclick="@(() => ToggleActive(context))">
                        @(context.IsActive ? "Ja" : "Nee")
                    </span>
                </td>
            </RowTemplate>
        </Table>

        @if (_leaders.Count == 0)
        {
            <div class="text-muted">Geen reisleiders gevonden.</div>
        }
    </div>
</div>