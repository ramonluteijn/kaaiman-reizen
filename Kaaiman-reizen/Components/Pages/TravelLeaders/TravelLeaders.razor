@page "/travelleaders"
@rendermode InteractiveServer
@using Kaaiman_reizen.Models.ViewModels
@using Kaaiman_reizen.Data.Services
@using Kaaiman_reizen.Data.Entities
@inject IJSRuntime JS

<PageTitle>Reisleiders</PageTitle>

<h1 class="h4">Reisleiders</h1>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <label class="form-label">Filteren</label>
                <input class="form-control" type="text" id="filterInput" onkeyup="filterList()" placeholder="Zoek op reisleider">
            </div>

            <div class="col-sm-6">
                <label class="form-label">Sorteren</label>
                <select class="form-control" name="sortInput" id="sortInput" onchange="sortList()">
                    <option value="name">naam</option>
                    <option value="amountOfTrips">Reizen ervaring</option>
                    <option value="minTrips">Min aantal reizen</option>
                    <option value="maxTrips">Max aantal reizen</option>
                    <option value="active">Actief</option>

                </select>
                <label class="form-label">Oplopend</label>
                <input type="checkbox" id="ascendingInput" onchange="sortList()">
            </div>
        </div>

        <Table TItem="TravelLeaderViewModel" Items="_leaders" OnDelete="@OnDelete" Path="travelleaders" CreateText="Nieuwe reisleider" EditHrefSelector="@GetEditHref">
            <HeaderContent>
                <th>Naam</th>
                <th>Telefoon</th>
                <th>Reizen ervaring</th>
                <th>Min aantal reizen</th>
                <th>Max aantal reizen</th>
                <th>Beschikbaar</th>
                <th>Actief</th>
            </HeaderContent>
            <RowTemplate>
                <td id="name">@context.Name</td>
                <td>@context.PhoneNumber</td>
                <td id="amountOfTrips">@context.AmountOfTrips</td>
                <td id="minTrips">@context.MinTrips</td>
                <td id="maxTrips">@context.MaxTrips</td>
                <td>
                    @context.Availability
                </td>
                <td id="active">
                    <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")" style="cursor: pointer;" @onclick="@(() => ToggleActive(context))">
                        @(context.IsActive ? "Ja" : "Nee")
                    </span>
                </td>
            </RowTemplate>
        </Table>

        @if (_leaders.Count == 0)
        {
            <div class="text-muted">Geen reisleiders gevonden.</div>
        }
    </div>
</div>

<script src="/js/Filter.js"></script>
<script src="/js/Sort.js"></script>
