@page "/travelleaders"
@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer
@using Kaaiman_reizen.Models.ViewModels
@inject IJSRuntime JS

<PageTitle>Reisleiders</PageTitle>

<h1 class="h4">Reisleiders</h1>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <input class="form-control w-25"
                   placeholder="Zoek op naam..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />

            <a href="travelleaders/create" class="btn btn-primary text-uppercase" style="background-color: #00796b; border: none;">
                <i class="bi bi-plus"></i> Nieuwe reisleider
            </a>
        </div>
            
            <Table TItem="TravelLeaderViewModel" Items="FilteredLeaders" OnDelete="@OnDelete" Path="travelleaders" EditHrefSelector="@GetEditHref">
            <HeaderContent>
                <th @onclick='() => SortBy("Name")'>
                    Naam @(GetSortIcon("Name"))
                </th>
                <th>E-mailadres</th>
                <th>Telefoon</th>
                <th @onclick='() => SortBy("Experience")'>
                    Reizen Ervaring @(GetSortIcon("Experience"))
                </th>
                <th @onclick='() => SortBy("Minimum")'>
                    Minimaal Aantal Reizen @(GetSortIcon("Minimum"))
                </th>
                <th @onclick='() => SortBy("Maximum")'>
                    Maximaal Aantal Reizen @(GetSortIcon("Maximum"))
                </th>
                <th>Beschikbaar</th>
                <th @onclick='() => SortBy("Active")'>
                    Actief @(GetSortIcon("Active"))
                </th>
                <th>Reisgeschiedenis</th>
            </HeaderContent>
            <RowTemplate>
                <td>@context.Name</td>
                <td>@context.Email</td>
                <td>@context.PhoneNumber</td>
                <td>@context.AmountOfTrips</td>
                <td>@context.MinTrips</td>
                <td>@context.MaxTrips</td>
                <td>@context.Availability</td>
                <td>
                    <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")">
                        @(context.IsActive ? "Ja" : "Nee")
                    </span>
                </td>
                <td>
                    @if (context.JourneyHistory.Count == 0)
                    {
                        <span class="text-muted">Nog geen reizen</span>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-1">
                            @foreach (var journey in context.JourneyHistory)
                            {
                                <a href="@GetJourneyHref(journey.JourneyId)">
                                    @journey.JourneyName (@journey.Start.ToString("dd-MM-yyyy") - @journey.End.ToString("dd-MM-yyyy"))
                                </a>
                            }
                        </div>
                    }
                </td>
            </RowTemplate>
        </Table>

        @if (_leaders.Count == 0)
        {
            <div class="text-muted">Geen reisleiders gevonden.</div>
        }
    </div>
</div>

<AlertModal IsOpen="@_isDeleteModalOpen"
            IsOpenChanged="HandleDeleteModalChanged"
            Title="Reisleider verwijderen"
            Severity="Severity.Warning"
            Dismissible="true"
            CloseOnBackdropClick="true"
            Message="@_deleteModalMessage">
    <Actions>
        <MudButton Variant="Variant.Text" OnClick="CloseDeleteModalAsync">
            Annuleren
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteAsync">
            Verwijderen
        </MudButton>
    </Actions>
</AlertModal>