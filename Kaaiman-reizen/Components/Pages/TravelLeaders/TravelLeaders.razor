@page "/travelleaders"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Planner")]
@inject IJSRuntime JS

<PageTitle>Reisleiders</PageTitle>

<h1 class="h4">Reisleiders</h1>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <input class="form-control w-25"
                   placeholder="Zoek op naam..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />

            <a href="travelleaders/create" class="btn btn-primary text-uppercase" style="background-color: #00796b; border: none;">
                <i class="bi bi-plus"></i> Nieuwe reisleider
            </a>
        </div>

        <Table TItem="TravelLeaderViewModel" Items="FilteredLeaders" OnDelete="@OnDelete" Path="travelleaders" EditHrefSelector="@GetEditHref">
            <HeaderContent>
                <th class="leader-name-column" @onclick='() => SortBy("Name")'>
                    Reisleider @(GetSortIcon("Name"))
                </th>
                <th class="leader-contact-column">Contact</th>
                <th class="leader-metric-column text-center" @onclick='() => SortBy("Experience")'>
                    Ervaring @(GetSortIcon("Experience"))
                </th>
                <th class="leader-metric-column text-center" @onclick='() => SortBy("Minimum")'>
                    Min @(GetSortIcon("Minimum"))
                </th>
                <th class="leader-metric-column text-center" @onclick='() => SortBy("Maximum")'>
                    Max @(GetSortIcon("Maximum"))
                </th>
                <th class="leader-preferences-column">Voorkeuren</th>
                <th class="leader-status-column text-center" @onclick='() => SortBy("Active")'>
                    Status @(GetSortIcon("Active"))
                </th>
            </HeaderContent>
            <RowTemplate>
                <td class="leader-name-cell">
                        <div class="d-flex flex-column">
                            <span class="fw-semibold">@context.Name</span>
                            <span class="text-muted small">@context.Email</span>
                        </div>
                </td>
                <td class="leader-contact-cell">
                    <span class="text-muted">@context.PhoneNumber</span>
                </td>
                <td class="leader-metric-cell text-center">
                    <span class="leader-metric">@(context.AmountOfTrips?.ToString() ?? "—")</span>
                </td>
                <td class="leader-metric-cell text-center">
                    <span class="leader-metric">@(context.MinTrips?.ToString() ?? "—")</span>
                </td>
                <td class="leader-metric-cell text-center">
                    <span class="leader-metric">@(context.MaxTrips?.ToString() ?? "—")</span>
                </td>
                <td class="leader-preferences-cell">
                    @if (!context.AvailableForJourneys.Any())
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-1">
                            @foreach (var name in context.AvailableForJourneys)
                            {
                                <span class="leader-preference">@name</span>
                            }
                        </div>
                    }
                </td>
                <td class="leader-status-cell text-center">
                    <span class="badge rounded-pill @(context.IsActive ? "bg-success" : "bg-secondary")">
                        @(context.IsActive ? "Actief" : "Inactief")
                    </span>
                    <div class="mt-1">
                        @if (_publishedLeaderIds.Contains(context.Id))
                        {
                            <span class="badge bg-primary small">In planning</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted small">Niet gepland</span>
                        }
                    </div>
                </td>
            </RowTemplate>
        </Table>

        @if (_leaders.Count == 0)
        {
            <div class="text-muted">Geen reisleiders gevonden.</div>
        }
    </div>
</div>

<AlertModal IsOpen="@_isDeleteModalOpen"
            IsOpenChanged="HandleDeleteModalChanged"
            Title="Reisleider verwijderen"
            Severity="Severity.Warning"
            Dismissible="true"
            CloseOnBackdropClick="true"
            Message="@_deleteModalMessage">
    <Actions>
        <MudButton Variant="Variant.Text" OnClick="CloseDeleteModalAsync">
            Annuleren
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteAsync">
            Verwijderen
        </MudButton>
    </Actions>
</AlertModal>