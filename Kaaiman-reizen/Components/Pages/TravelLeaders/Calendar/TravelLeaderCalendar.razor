@page "/travelleaders/calendar"
@attribute [Authorize(Roles = "Reisleider")]
@rendermode InteractiveServer

<PageTitle>Mijn Reizen</PageTitle>

<h1 class="h4 d-flex align-items-center gap-2">Mijn Reizen
    <Tooltip>
        <strong>Mijn reizen — hoe werkt dit?</strong>
        <ul>
            <li>Hier ziet u de reizen waarvoor u momenteel bent ingepland.</li>
            <li>De kalender toont uw reizen per datum zodat u snel uw planning kunt bekijken.</li>
            <li>Gebruik deze pagina om uw eigen inzet en reisindeling te volgen.</li>
        </ul>
    </Tooltip>
</h1>

<div class="card">
    <div class="card-body">
        @if (_loading)
        {
            <div class="text-muted">Gegevens laden...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <AlertModal IsOpen="true"
                        Title="Kalender"
                        Severity="Severity.Info"
                        Message="@_statusMessage" />
        }
        else
        {
            <CalendarView Journeys="@_journeys"/>
        }
    </div>
</div>
