@page "/travelleaders/calendar"
@attribute [Authorize(Roles = "Reisleider")]
@rendermode InteractiveServer

<PageTitle>Mijn Reizen</PageTitle>

<h1 class="h4">Mijn Reizen</h1>

<div class="card">
    <div class="card-body">
        @if (_loading)
        {
            <div class="text-muted">Gegevens laden...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <AlertModal IsOpen="true"
                        Title="Kalender"
                        Severity="Severity.Info"
                        Message="@_statusMessage" />
        }
        else
        {
            <CalendarView Journeys="@_journeys"/>
        }
    </div>
</div>
