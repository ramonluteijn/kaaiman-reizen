@page "/travelleaders/edit/{Id:int}"
@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer

<PageTitle>Bewerk reisleider</PageTitle>

<h1 class="h4">Bewerk reisleider</h1>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show my-4" role="alert" id="error-alert">
        <strong>Oeps!</strong> @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (_loading)
        {
            <div>Bezig met laden…</div>
        }
        else if (_notFound)
        {
            <div class="text-muted">Reisleider niet gevonden.</div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" FormName="EditTravelLeaderForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Naam</label>
                    <InputText class="form-control" @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mailadres</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Telefoon</label>
                    <InputText class="form-control" @bind-Value="_model.PhoneNumber" />
                    <ValidationMessage For="() => _model.PhoneNumber" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Aantal reizen</label>
                    <InputNumber class="form-control" @bind-Value="_model.AmountOfTrips" />
                    <ValidationMessage For="() => _model.AmountOfTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Minimaal aantal reizen per jaar</label>
                    <InputNumber class="form-control" @bind-Value="_model.MinTrips" />
                    <ValidationMessage For="() => _model.MinTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Maximaal aantal reizen per jaar</label>
                    <InputNumber class="form-control" @bind-Value="_model.MaxTrips" />
                    <ValidationMessage For="() => _model.MaxTrips" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Notitie</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Note" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.IsActive" />
                    <label class="form-check-label">Actief</label>
                </div>

                <div class="app-form-actions">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save">
                        Opslaan
                    </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="Cancel">
                            Annuleren
                        </MudButton>
                </div>
            </EditForm>
        }
    </div>
</div>


