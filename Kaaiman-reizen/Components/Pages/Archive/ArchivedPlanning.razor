@page "/archive/planning/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer

<PageTitle>Bekijk Planning</PageTitle>

<h1 class="h4">Planning
    <Tooltip>
        <strong>Planning — hoe werkt dit?</strong>
        <ul>
            <li>De kalender toont alle reizen in de geselecteerde planning per datum.</li>
            <li>Gebruik de navigatie in de kalender om naar een andere periode te gaan.</li>
        </ul>
    </Tooltip>
</h1>

<div class="card">
    <div class="card-body">
        @if (_loading)
        {
            <div class="text-muted">Gegevens laden...</div>
        }
        else
        {
            <CalendarView Journeys="@_journeys"/>
        }
    </div>
</div>
