@page "/journeys/create"
@using Kaaiman_reizen.Data.Entities
@using Kaaiman_reizen.Data.Enum
@using Kaaiman_reizen.Data.Services
@rendermode InteractiveServer
@inject IJourneyService JourneyService
@inject ITravelLeaderService LeaderService
@inject NavigationManager Navigation

<PageTitle>Nieuwe reis</PageTitle>

<h1 class="h4">Nieuwe reis</h1>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Start met een eerdere reis</label>
            <InputSelect TValue="int?" class="form-control"
                         Value="_selectedTemplateJourneyId"
                         ValueChanged="OnTemplateChanged"
                         ValueExpression="() => _selectedTemplateJourneyId">
                <option value="">Geen (lege reis)</option>
                @foreach (var journey in _journeys)
                {
                    <option value="@journey.Id">@journey.Name (@journey.Start.ToString("dd-MM-yyyy"))</option>
                }
            </InputSelect>
            <small class="text-muted">Kies een vorige reis om dit formulier automatisch te vullen.</small>
        </div>

        <EditForm Model="_model" @key="_model" OnValidSubmit="HandleValidSubmit" FormName="CreateJourneyForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Reis</label>
                <InputText class="form-control" @bind-Value="_model.Name" />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Start datum</label>
                <InputDate class="form-control" @bind-Value:get="_model.Start" @bind-Value:set="OnStartDateChanged" />
                <ValidationMessage For="() => _model.Start" />
            </div>

            <div class="mb-3">
                <label class="form-label">Eind datum</label>
                <InputDate class="form-control"  @bind-Value:get="_model.End" @bind-Value:set="OnEndDateChanged" />
                <ValidationMessage For="() => _model.End" />
            </div>

            <div class="mb-3">
                <label class="form-label">Busjes</label>
                <InputNumber class="form-control" @bind-Value="_model.Busses" />
                <ValidationMessage For="() => _model.Busses" />
            </div>

            <div class="mb-3">
                <label class="form-label">Reizigers</label>
                <InputNumber class="form-control" @bind-Value="_model.Travelers" />
                <ValidationMessage For="() => _model.Travelers" />
            </div>

            <div class="mb-3">
                <label class="form-label">Boekingsstatus</label>
                <InputSelect class="form-control" @bind-Value="_model.BookingStatus">
                    <option value="@BookingStatus.Huidig">Huidig</option>
                    <option value="@BookingStatus.Geweest">Geweest</option>
                    <option value="@BookingStatus.Geanuleerd">Geannuleerd</option>
                </InputSelect>
                <ValidationMessage For="() => _model.BookingStatus" />
            </div>

            <div class="mb-3">
                <label class="form-label">Reisleiders</label>
                <p>Gebruik CTRL en SHIFT om meerdere reisleiders te selecteren</p>
                <select multiple class="form-control mb-3 app-multiselect" @onchange="OnLeadersChanged">
                    @foreach (var leader in _leaders)
                    {
                        <option value="@leader.Id">@leader.Name</option>
                    }
                </select>
            </div>

            <div class="app-form-actions">
                <button type="submit" class="btn btn-primary">Opslaan</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Annuleren</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Journey _model { get; set; } = new() { Start = DateOnly.FromDateTime(DateTime.Today), End = DateOnly.FromDateTime(DateTime.Today) };
    private string[] _preferred = new string[3];
    private List<TravelLeader> _leaders = new();
    private List<int> _selectedLeaderIds = new();
    private List<Journey> _journeys = new();
    private int? _selectedTemplateJourneyId;

    private void OnTemplateChanged(int? selectedJourneyId)
    {
        _selectedTemplateJourneyId = selectedJourneyId;
        ApplySelectedTemplate();
    }

    private void ApplySelectedTemplate()
    {
        if (!_selectedTemplateJourneyId.HasValue)
        {
            _model = new Journey { Start = DateOnly.FromDateTime(DateTime.Today), End = DateOnly.FromDateTime(DateTime.Today) };
            _selectedLeaderIds = new List<int>();
            return;
        }

        var selectedJourney = _journeys.FirstOrDefault(j => j.Id == _selectedTemplateJourneyId.Value);
        if (selectedJourney is null)
            return;

        _model = new Journey
        {
            Name = selectedJourney.Name,
            Start = selectedJourney.Start,
            End = selectedJourney.End,
            Busses = selectedJourney.Busses,
            Travelers = selectedJourney.Travelers,
            BookingStatus = selectedJourney.BookingStatus,
            RequiredLeaders = selectedJourney.RequiredLeaders
        };
    }

    private void OnLeadersChanged(ChangeEventArgs e)
    {
        var selectedValues = e.Value as String[];

        if (selectedValues is not null)
            _selectedLeaderIds = selectedValues
                .Select(int.Parse)
                .ToList();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/journeys");
    }

    private async Task HandleValidSubmit()
    {
        await JourneyService.AddJourneyAsync(_model, _selectedLeaderIds);
        Navigation.NavigateTo("/journeys");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var leaders = await LeaderService.GetTravelLeadersAsync();
            _leaders = leaders.ToList();
            
            var journeys = await JourneyService.GetJourneysAsync();
            _journeys = journeys.ToList();
        }
        catch
        {
            _leaders = new List<TravelLeader>();
            _journeys = new List<Journey>();
        }
    }
    
    private void OnStartDateChanged(DateOnly startDate)
    {
        _model.Start = startDate;
        UpdateStatus();
    }

    private void OnEndDateChanged(DateOnly endDate)
    {
        BookingStatus.Huidig => "Huidig",
        BookingStatus.Geweest => "Geweest",
        BookingStatus.Geanuleerd => "Geannuleerd",
        _ => status.ToString()
    };
}
