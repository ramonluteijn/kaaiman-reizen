@page "/journeys"
@using Kaaiman_reizen.Data.Services
@using Kaaiman_reizen.Data.Entities
@using Kaaiman_reizen.Data.Enum
@using Kaaiman_reizen.Helpers
@rendermode InteractiveServer
@inject IJourneyService JourneyService
@inject IPlanningRoundService RoundService

<PageTitle>Reizen</PageTitle>

<h1 class="h4 d-flex align-items-center gap-2">Reizen
    <Tooltip>
        <strong>Reizen — hoe werkt dit?</strong>
        <ul>
            <li>Gebruik de zoekbalk om op land of reisnaam te zoeken.</li>
            <li>Klik op een kolomkop om de lijst te sorteren.</li>
            <li>Klik op "Nieuwe reis" om een nieuwe reis aan te maken.</li>
            <li>Bewerk of verwijder reizen via de acties in de tabelrij.</li>
            <li>Gebruik "Excel Importeren" om meerdere reizen tegelijk toe te voegen.</li>
        </ul>
    </Tooltip>
</h1>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between flex-wrap-reverse align-items-center mb-3 gap-2">
            <input class="form-control w-auto" 
                placeholder="Zoek op land..."
                @bind="_searchTerm" 
                @bind:event="oninput" />

            <div class="d-flex gap-2 flex-wrap-reverse">
                <AuthorizeView Roles="Planner">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.EventNote"
                               OnClick="() => _isCreateRoundModalOpen = true">
                        Planningsronde aanmaken
                    </MudButton>
                </AuthorizeView>
                <a href="journeys/create" class="btn btn-primary text-uppercase"
                   style="background-color: #00796b; border: none;">
                    <i class="bi bi-plus"></i> Nieuwe reis
                </a>
            </div>
        </div>

        @* Tabs *@
        <div class="journey-tabs">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(_activeTab == 0 ? "active" : "")" type="button" @onclick="() => SetTab(0)">
                    Alle reizen
                    <span class="badge bg-secondary ms-1">@_journeys.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == 1 ? "active" : "")" type="button" @onclick="() => SetTab(1)">
                    Geen ronde
                    <span class="badge @(FreeJourneyCount > 0 ? "bg-warning text-dark" : "bg-secondary") ms-1">@FreeJourneyCount</span>
                </button>
            </li>
            @for (int i = 0; i < _rounds.Count; i++)
            {
                var round = _rounds[i];
                var capturedTab = i + 2;
                var count = JourneyCountForRound(round);
                <li class="nav-item">
                    <button class="nav-link @(_activeTab == capturedTab ? "active" : "")" type="button" @onclick="() => SetTab(capturedTab)">
                        @round.Name
                        <span class="badge bg-primary ms-1">@count</span>
                    </button>
                </li>
            }
        </ul>
        </div>

        @* Contextuele melding op "Geen ronde" tab *@
        @if (_activeTab == 1 && FreeJourneyCount == 0 && _journeys.Any(j => j.BookingStatus == BookingStatus.Huidig))
        {
            <div class="alert alert-success small mb-3 py-2">
                <i class="bi bi-check-circle me-1"></i>
                Alle actieve reizen zijn gekoppeld aan een planningsronde.
            </div>
        }

        <Table TItem="Journey" Items="FilteredJourneys" OnDelete="@OnDelete" Path="journeys"
               EditHrefSelector="@GetEditHref">
            <HeaderContent>
                <th class="journey-name-column" @onclick='() => SortBy("Name")'>
                    Reis @(GetSortIcon("Name"))
                </th>
                <th class="journey-period-column" @onclick='() => SortBy("StartDate")'>
                    Periode @(GetSortIcon("StartDate"))
                </th>
                <th class="journey-planning-column">
                    Planning
                </th>
                <th class="journey-leaders-column">
                    Reisleiders
                </th>
                <th class="journey-booking-column" @onclick='() => SortBy("BookingStatus")'>
                    Boekingsstatus @(GetSortIcon("BookingStatus"))
                </th>
                <th class="journey-metric-column text-center" @onclick='() => SortBy("Busses")'>
                    Busjes @(GetSortIcon("Busses"))
                </th>
                <th class="journey-metric-column text-center" @onclick='() => SortBy("Travelers")'>
                    Reizigers @(GetSortIcon("Travelers"))
                </th>
            </HeaderContent>
            <RowTemplate>
                <td class="journey-name-cell">
                    <span class="fw-semibold">@context.Name</span>
                </td>
                <td class="journey-period-cell">
                    <div class="d-flex flex-column">
                        <span class="fw-semibold">@DateDisplay.FormatDate(context.Start)</span>
                        <span class="text-muted small">t/m @DateDisplay.FormatDate(context.End)</span>
                    </div>
                </td>
                <td class="journey-planning-cell">
                    <span class="badge rounded-pill @(context.TravelLeaders != null && context.TravelLeaders.Any() ? "bg-success" : "bg-secondary")">
                        @(context.TravelLeaders != null && context.TravelLeaders.Any() ? "Gepubliceerd" : "Gepland")
                    </span>
                </td>
                <td class="journey-leaders-cell">
                    @if (context.TravelLeaders != null && context.TravelLeaders.Any())
                    {
                        <div class="d-flex flex-column gap-1">
                            @FormatTravelLeaders(context)
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td class="journey-booking-cell">
                    <span class="badge rounded-pill @(context.BookingStatus switch
                                       {
                                           BookingStatus.Huidig => "bg-success",
                                           BookingStatus.Geweest => "bg-secondary",
                                           BookingStatus.Geanuleerd => "bg-danger",
                                           _ => "bg-secondary"
                                       })">@context.BookingStatus</span>
                </td>
                <td class="journey-metric-cell text-center">
                    <span class="journey-metric">@(context.Busses?.ToString() ?? "—")</span>
                </td>
                <td class="journey-metric-cell text-center">
                    <span class="journey-metric">@(context.Travelers?.ToString() ?? "—")</span>
                </td>
            </RowTemplate>
        </Table>

        @if (!FilteredJourneys.Any())
        {
            <div class="text-muted mb-3">Geen reizen gevonden.</div>
        }

        <div class="mb-3 mt-3">
            <label for="excelImport">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile"
                           HtmlTag="span">
                    Excel Importeren
                </MudButton>
            </label>

            <InputFile id="excelImport" OnChange="ImportExcelFile" hidden />
        </div>

        <MudText Typo="Typo.body2" Class="mud-text-secondary italic">
            Excel sheet dient er als volgt uit te zien:
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary italic">
            Reis (tekst) | Start datum (datum) | Eind datum (datum) | Busjes (nummer) | Reizigers (nummer) |
            Boekingsstatus (0, 1, 2)
        </MudText>
    </div>
</div>

@* Modal voor aanmaken planningsronde *@
<PlanningRoundCreateModal IsOpen="@_isCreateRoundModalOpen"
                          IsOpenChanged="@(v => _isCreateRoundModalOpen = v)"
                          Journeys="_journeys"
                          ExistingRounds="_rounds" />

@* Alert modal for deletion *@
<AlertModal IsOpen="@_isDeleteModalOpen" IsOpenChanged="HandleDeleteModalChanged" Title="Reis verwijderen"
            Severity="Severity.Warning" Dismissible="true" CloseOnBackdropClick="true" Message="@DeleteModalMessage">
    <Actions>
        <MudButton Variant="Variant.Text" OnClick="CloseDeleteModalAsync">
            Annuleren
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteAsync">
            Verwijderen
        </MudButton>
    </Actions>
</AlertModal>

@* Alert modal for bulk import *@
<AlertModal IsOpen="@_isImportModalOpen" IsOpenChanged="HandleDeleteModalChanged" Title="Reizen importeren"
            Severity="Severity.Info" Dismissible="true" CloseOnBackdropClick="true" Message="@ImportModalMessage">
    <Actions>
        <MudButton Variant="Variant.Text" OnClick="CloseImportModalAsync">
            Annuleren
        </MudButton>
    </Actions>
</AlertModal>

@code {
    private List<Journey> _journeys = new();
    private List<PlanningRound> _rounds = [];
    private string _searchTerm = string.Empty;
    private string _sortColumn = "Country";
    private bool _sortAscending = true;
    private int _activeTab = 0;

    private bool _isDeleteModalOpen;
    private bool _isImportModalOpen;
    private bool _isCreateRoundModalOpen;
    private Journey? _journeyPendingDelete;
    private String? _bulkImportInfo;

    private string DeleteModalMessage => _journeyPendingDelete is null
        ? "Weet je zeker dat je deze reis wilt verwijderen?"
        : $"Weet je zeker dat je '{_journeyPendingDelete.Name}' wilt verwijderen?";

    private string ImportModalMessage => _bulkImportInfo is null
        ? "Nieuwe reizen uit excel bestand zijn succesvol toegevoegd"
        : $"Nieuwe reizen uit excel bestand zijn niet succesvol toegevoegd: '{_bulkImportInfo}'";

    private int FreeJourneyCount => _journeys.Count(j =>
        j.BookingStatus == BookingStatus.Huidig &&
        j.PlanningRoundId == null);

    private int JourneyCountForRound(PlanningRound round) =>
        _journeys.Count(j => j.BookingStatus == BookingStatus.Huidig
                           && j.PlanningRoundId == round.Id);

    private void SetTab(int tab) => _activeTab = tab;

    private static string GetEditHref(Journey journey) => $"/journeys/edit/{journey.Id}";

    private static bool HasPublishedPlanning(Journey journey)
    {
        return journey.TravelLeaders != null && journey.TravelLeaders.Any();
    }

    private static string GetPlanningStatusLabel(Journey journey)
    {
        return HasPublishedPlanning(journey) ? "Gepubliceerd" : "Gepland";
    }

    private static string GetPlanningStatusClass(Journey journey)
    {
        return HasPublishedPlanning(journey) ? "bg-success" : "bg-secondary";
    }

    private string FormatTravelLeaders(Journey journey)
    {
        var leaders = journey.TravelLeaders ?? new List<TravelLeader>();
        return string.Join("; ", leaders.OrderBy(l => l.Name).Select(l => l.Name));
    }

    private IEnumerable<Journey> TabFilteredJourneys => _activeTab switch
    {
        0 => _journeys,
        1 => _journeys.Where(j =>
                j.BookingStatus == BookingStatus.Huidig &&
                j.PlanningRoundId == null),
        _ when _activeTab - 2 < _rounds.Count =>
            _journeys.Where(j =>
                j.BookingStatus == BookingStatus.Huidig &&
                j.PlanningRoundId == _rounds[_activeTab - 2].Id),
        _ => _journeys
    };

    private IEnumerable<Journey> FilteredJourneys =>
        ApplySorting(
            TabFilteredJourneys.Where(j =>
                string.IsNullOrWhiteSpace(_searchTerm) ||
                j.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
        ));

    private IEnumerable<Journey> ApplySorting(IEnumerable<Journey> query)
    {
        return _sortColumn switch
        {
            "Name" => _sortAscending ? query.OrderBy(x => x.Name) : query.OrderByDescending(x => x.Name),
            "StartDate" => _sortAscending ? query.OrderBy(x => x.Start) : query.OrderByDescending(x => x.Start),
            "EndDate" => _sortAscending ? query.OrderBy(x => x.End) : query.OrderByDescending(x => x.End),
            "BookingStatus" => _sortAscending ? query.OrderBy(x => x.BookingStatus) : query.OrderByDescending(x => x.BookingStatus),
            "Busses" => _sortAscending ? query.OrderBy(x => x.Busses) : query.OrderByDescending(x => x.Busses),
            "Travelers" => _sortAscending ? query.OrderBy(x => x.Travelers) : query.OrderByDescending(x => x.Travelers),
            _ => query
        };
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "↑" : "↓";
    }

    private async Task OnDelete(Journey? journey)
    {
        if (journey == null) return;
        _journeyPendingDelete = journey;
        _isDeleteModalOpen = true;
    }

    private Task HandleDeleteModalChanged(bool isOpen)
    {
        _isDeleteModalOpen = isOpen;
        if (!isOpen) _journeyPendingDelete = null;
        return Task.CompletedTask;
    }

    private Task CloseDeleteModalAsync()
    {
        _isDeleteModalOpen = false;
        _journeyPendingDelete = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_journeyPendingDelete is null) return;

        var journeyId = _journeyPendingDelete.Id;
        await JourneyService.DeleteJourneyAsync(journeyId);
        _journeys.RemoveAll(l => l.Id == journeyId);
        _isDeleteModalOpen = false;
        _journeyPendingDelete = null;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await JourneyService.GetJourneysAsync();
            _journeys = items.ToList();
        }
        catch
        {
            _journeys = new List<Journey>();
        }

        try
        {
            var rounds = await RoundService.GetAllAsync();
            _rounds = rounds.ToList();
        }
        catch
        {
            _rounds = [];
        }
    }

    async Task ImportExcelFile(InputFileChangeEventArgs e)
    {
        MemoryStream ms = new MemoryStream();
        await e.File.OpenReadStream().CopyToAsync(ms);
        ms.Position = 0;

        var result = await JourneyService.ImportJourneysAsync(ms);
        foreach (var journey in result.journeys)
            _journeys.Add(journey);

        _bulkImportInfo = result.warning;
        _isImportModalOpen = true;
    }

    private Task CloseImportModalAsync()
    {
        _isImportModalOpen = false;
        _bulkImportInfo = null;
        return Task.CompletedTask;
    }
}
