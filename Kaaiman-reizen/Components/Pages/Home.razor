@page "/"

@using Kaaiman_reizen.Components.Pages.Planner.Components
@using Kaaiman_reizen.Data.Enum

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

@if (_isPlanner)
{
    <h1 class="h4 mb-3 d-flex align-items-center gap-2">Planning dashboard
        <Tooltip>
            <strong>Dashboard — hoe werkt dit?</strong>
            <ul>
                <li>Bekijk hier een overzicht van de huidige reisplanning, inclusief concepten en gepubliceerde reizen.</li>
                <li>Gebruik de knoppen en links om concepten te beheren, nieuwe reizen aan te maken, en reisleiders te beheren.</li>
                <li>Controleer de secties "Reizen zonder reisleiders" en "Reisleiders zonder reis" om eventuele hiaten in de planning te identificeren.</li>
                <li>Bekijk notities van reisleiders om belangrijke informatie of opmerkingen te zien die van invloed kunnen zijn op de planning.</li>
            </ul>
        </Tooltip>
    </h1>
}
else
{
    <h1 class="h4 mb-3 d-flex align-items-center gap-2">Home
        <Tooltip>
            <strong>Home — hoe werkt dit?</strong>
            <ul>
                <li>Bekijk hier een overzicht van uw huidige reisplanning, inclusief gepubliceerde reizen.</li>
                <li>Gebruik de links om details van uw reizen te bekijken en eventuele opmerkingen van reisleiders te zien.</li>
                <li>Controleer regelmatig deze pagina voor updates over uw reizen en eventuele nieuwe notities van reisleiders.</li>
            </ul>
        </Tooltip>
    </h1>
}

@if (_loading)
{
    <div class="text-muted">Gegevens laden...</div>
}
else
{
    @if (_notifications.Any())
    {
        <AlertModal IsOpen="true" Title="Notificaties" Severity="Severity.Info" Dismissible="false"
                    CloseOnBackdropClick="false">
            <MudStack Spacing="1">
                @foreach (var notification in _notifications)
                {
                    <MudPaper Class="pa-3 d-flex align-center justify-space-between gap-3" Outlined="true">
                        <MudText Typo="Typo.body2">@notification.Message</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="@(() => MarkNotificationAsRead(notification))" aria-label="Melding sluiten" />
                    </MudPaper>
                }
            </MudStack>
        </AlertModal>
    }

    @if (_isPlanner)
    {
        <section>

            @* ── Leaders banner ── *@
            @{
                var unverifiedRound = _rounds.FirstOrDefault(r => r.LeadersVerifiedAt is null);
            }
            @if (unverifiedRound is not null)
            {
                <MudPaper Class="pa-3 mb-4 d-flex align-center justify-space-between flex-wrap gap-3"
                          Elevation="1"
                          Style="border-left: 4px solid #2e7d32;">
                    <div class="d-flex align-center gap-2">
                        <span class="material-icons" style="color: #2e7d32;">group</span>
                        <div>
                            <MudText Typo="Typo.body1">
                                Ronde <strong>@unverifiedRound.Name</strong> is aangemaakt — kloppen alle actieve reisleiders nog?
                            </MudText>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <MudButton Href="/travelleaders"
                                   Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small">
                            Reisleiders bekijken
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="@(() => VerifyLeadersAsync(unverifiedRound))">
                            Bevestigen
                        </MudButton>
                    </div>
                </MudPaper>
            }

            @* ── Planning round steps cards ── *@
            @if (!_rounds.Any())
            {
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent Class="d-flex flex-column align-center py-6">
                        <span class="material-icons mb-2" style="font-size: 48px; color: #9e9e9e;">event_note</span>
                        <MudText Typo="Typo.h6" Class="mb-1">Nog geen planningsrondes</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            Maak een ronde aan om het stappenplan te starten.
                        </MudText>
                        <MudButton Href="/planner/rounds"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.Add">
                            Ronde aanmaken
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                @foreach (var round in _rounds)
                {
                    var isExpanded = _expandedRounds.Contains(round.Id);
                    var isPublished = round.Versions.Any(v => v.IsPublished);

                    @if (!isExpanded)
                    {
                        <MudPaper Class="pa-3 mb-2 d-flex align-center justify-space-between" Elevation="1">
                            <div class="d-flex align-center gap-2">
                                @if (isPublished)
                                {
                                    <span class="material-icons" style="color: #2e7d32; font-size: 18px;">check_circle</span>
                                }
                                <MudText Typo="Typo.body1"><strong>@round.Name</strong></MudText>
                                @if (isPublished)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Gepubliceerd</MudChip>
                                }
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.ExpandMore"
                                           Size="Size.Small"
                                           OnClick="@(() => ToggleRound(round.Id))"
                                           aria-label="Uitklappen" />
                        </MudPaper>
                    }
                    else
                    {
                        <div class="mb-4">
                            <PlanningRoundSteps Model="@BuildPlanningRoundSteps(round)" />
                        </div>
                        @if (isPublished)
                        {
                            <div class="mb-2" style="text-align: right;">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.ExpandLess"
                                           OnClick="@(() => ToggleRound(round.Id))">
                                    Inklappen
                                </MudButton>
                            </div>
                        }
                    }
                }
            }

            @* ── PDF banner ── *@
            @{
                var publishedRound = _rounds
                    .Where(r => r.Versions.Any(v => v.IsPublished))
                    .OrderByDescending(r => r.Year)
                    .ThenByDescending(r => r.StartDate)
                    .FirstOrDefault();
                var publishedVersion = publishedRound?.Versions
                    .Where(v => v.IsPublished)
                    .OrderByDescending(v => v.CreatedAt)
                    .FirstOrDefault();
            }
            @if (_publishedPlanning && publishedRound is not null && publishedVersion is not null)
            {
                <MudPaper Class="pa-3 mb-4 d-flex align-center justify-space-between flex-wrap gap-3"
                          Elevation="1"
                          Style="border-left: 4px solid var(--mud-palette-primary);">
                    <div class="d-flex align-center gap-2">
                        <span class="material-icons" style="color: var(--mud-palette-primary);">picture_as_pdf</span>
                        <div>
                            <MudText Typo="Typo.body1">
                                Definitieve planning — <strong>@publishedRound.Name</strong>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Gepubliceerd op @publishedVersion.CreatedAt.ToString("d MMM yyyy")
                            </MudText>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="HandlePrintPdf"
                               EndIcon="@Icons.Material.Filled.PictureAsPdf">
                        Download als PDF
                    </MudButton>
                </MudPaper>
            }
            
            <MudGrid Class="mt-1">

                <MudItem xs="12" sm="12" md="6">
                    <MudCard Elevation="2" Class="h-100">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-3">Voorkeuren per ronde</MudText>

                            @if (!_rounds.Any())
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Nog geen rondes aangemaakt.</MudText>
                            }
                            else
                            {
                                <div style="max-height: 240px; overflow-y: auto;" class="pr-2">
                                    @foreach (var round in _rounds)
                                    {
                                        var total = round.Participations.Count;
                                        var submitted = round.Participations.Count(p => p.Status == ParticipationStatus.Submitted);
                                        var deadlinePassed = DateTime.UtcNow > round.PreferenceDeadline;
                                        var pct = total > 0 ? (submitted * 100 / total) : 0;
                                        var barColor = (submitted == total && total > 0) ? "#2e7d32"
                                            : deadlinePassed ? "#c62828"
                                            : "#ef6c00";

                                        <div class="mb-3">
                                            <div class="d-flex justify-space-between mb-1">
                                                <MudText Typo="Typo.body2"><strong>@round.Name</strong></MudText>
                                                <MudText Typo="Typo.body2" Style="@($"color: {barColor}; font-weight: 600;")">
                                                    @submitted / @total ingediend
                                                </MudText>
                                            </div>
                                            <div style="height: 6px; background: #e0e0e0; border-radius: 3px; overflow: hidden;">
                                                <div style="@($"height: 100%; width: {pct}%; background: {barColor}; border-radius: 3px; transition: width 0.3s;")"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="12" md="6">
                    <MudCard Elevation="2" Class="h-100">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="mb-3">Concept &amp; publicatie</MudText>

                            @if (!_rounds.Any())
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Nog geen rondes aangemaakt.</MudText>
                            }
                            else
                            {
                                <MudList T="string" Dense="true" DisablePadding="true">
                                    @foreach (var round in _rounds)
                                    {
                                        var published = round.Versions.Any(v => v.IsPublished);
                                        var hasDraft = round.Versions.Any(v => !v.IsPublished);
                                        var stale = IsDraftStale(round);

                                        string badge;
                                        Color badgeColor;
                                        if (published)
                                        {
                                            badge = "Gepubliceerd";
                                            badgeColor = Color.Success;
                                        }
                                        else if (stale)
                                        {
                                            badge = "Concept verouderd";
                                            badgeColor = Color.Warning;
                                        }
                                        else if (hasDraft)
                                        {
                                            badge = "Concept aanwezig";
                                            badgeColor = Color.Success;
                                        }
                                        else
                                        {
                                            badge = "Geen concept";
                                            badgeColor = Color.Default;
                                        }

                                        <MudListItem Class="py-1">
                                            <div class="d-flex align-center justify-space-between">
                                                <MudText Typo="Typo.body2">@round.Name</MudText>
                                                <MudChip T="string" Color="@badgeColor" Size="Size.Small">@badge</MudChip>
                                            </div>
                                        </MudListItem>
                                        <MudDivider />
                                    }
                                </MudList>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>


            </MudGrid>

        </section>
    }

    @if (_isReisleider)
    {
        <section>
            <h2 class="h5">Gepubliceerde planning</h2>

            @if (_publishedJourneys.Count == 0)
            {
                <div class="text-muted">Er is nog geen gepubliceerde planning zichtbaar.</div>
            }
            else
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive app-table-scroll">
                            <table class="app-table mb-0 table">
                                <thead>
                                    <tr>
                                        <th>Land</th>
                                        <th>Periode</th>
                                        <th>Reisleiders</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var journey in _publishedJourneys)
                                    {
                                        <tr>
                                            <td>@journey.Name</td>
                                            <td>@DateDisplay.FormatDate(journey.Start) - @DateDisplay.FormatDate(journey.End)</td>
                                            <td>@FormatTravelLeaders(journey)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </section>
    }
}
