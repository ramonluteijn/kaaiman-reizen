@page "/"

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

@if (_isPlanner)
{
    <h1 class="h4 mb-3 d-flex align-items-center gap-2">Planning dashboard
        <Tooltip>
            <strong>Dashboard — hoe werkt dit?</strong>
            <ul>
                <li>Bekijk hier een overzicht van de huidige reisplanning, inclusief concepten en gepubliceerde reizen.</li>
                <li>Gebruik de knoppen en links om concepten te beheren, nieuwe reizen aan te maken, en reisleiders te beheren.</li>
                <li>Controleer de secties "Reizen zonder reisleiders" en "Reisleiders zonder reis" om eventuele hiaten in de planning te identificeren.</li>
                <li>Bekijk notities van reisleiders om belangrijke informatie of opmerkingen te zien die van invloed kunnen zijn op de planning.</li>
            </ul>
        </Tooltip>
    </h1>
}
else
{
    <h1 class="h4 mb-3 d-flex align-items-center gap-2">Home
        <Tooltip>
            <strong>Home — hoe werkt dit?</strong>
            <ul>
                <li>Bekijk hier een overzicht van uw huidige reisplanning, inclusief gepubliceerde reizen.</li>
                <li>Gebruik de links om details van uw reizen te bekijken en eventuele opmerkingen van reisleiders te zien.</li>
                <li>Controleer regelmatig deze pagina voor updates over uw reizen en eventuele nieuwe notities van reisleiders.</li>
            </ul>
        </Tooltip>
    </h1>
}

@if (_loading)
{
    <div class="text-muted">Gegevens laden...</div>
}
else
{
    @if (_notifications.Any())
            {
                <AlertModal IsOpen="true" Title="Notificaties" Severity="Severity.Info" Dismissible="false"
                            CloseOnBackdropClick="false">
                    <MudStack Spacing="1">
                        @foreach (var notification in _notifications)
                        {
                            <MudPaper Class="pa-3 d-flex align-center justify-space-between gap-3" Outlined="true">
                                <MudText Typo="Typo.body2">@notification.Message</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               OnClick="@(() => MarkNotificationAsRead(notification))" aria-label="Melding sluiten" />
                            </MudPaper>
                        }
                    </MudStack>
                </AlertModal>
            }

            @if (_isPlanner)
            {
                <section>
                    <MudGrid Class="mt-1">

                        @* ── Planningsrondes statusoverzicht ── *@
                        @{
                            var activePublished = ActivePublishedRounds().ToList();
                            var pendingPrefs    = RoundsWithPendingPrefs().ToList();
                            var staleRounds     = RoundsWithStaleDraft().ToList();
                        }
                        @if (activePublished.Any() || pendingPrefs.Any() || staleRounds.Any())
                        {
                            <MudItem xs="12">
                                <MudCard Elevation="2">
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6" Class="mb-3">Planningsrondes</MudText>
                                        <MudStack Spacing="2">

                                            @foreach (var round in activePublished)
                                            {
                                                <MudPaper Class="pa-3 d-flex align-center justify-space-between flex-wrap gap-2" Outlined="true">
                                                    <div class="d-flex align-center gap-2 flex-wrap">
                                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                                        <div>
                                                            <MudText Typo="Typo.body1"><b>@round.Name</b></MudText>
                                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                                @round.StartDate.ToString("d MMM") – @round.EndDate.ToString("d MMM yyyy") · Gepubliceerd
                                                            </MudText>
                                                        </div>
                                                    </div>
                                                    <MudButton Href="@($"/planner/rounds/{round.Id}/draft")"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Primary"
                                                               Size="Size.Small"
                                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                                        Bekijk
                                                    </MudButton>
                                                </MudPaper>
                                            }

                                            @foreach (var item in pendingPrefs)
                                            {
                                                var daysLeft = (int)(item.Round.PreferenceDeadline.Date - DateTime.UtcNow.Date).TotalDays;
                                                <MudPaper Class="pa-3 d-flex align-center justify-space-between flex-wrap gap-2" Outlined="true">
                                                    <div class="d-flex align-center gap-2 flex-wrap">
                                                        <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="Color.Warning" Size="Size.Small" />
                                                        <div>
                                                            <MudText Typo="Typo.body1"><b>@item.Round.Name</b></MudText>
                                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                                @item.Pending van @item.Total reisleiders nog niet ingediend ·
                                                                deadline @(daysLeft == 0 ? "vandaag" : $"over {daysLeft} dag{(daysLeft == 1 ? "" : "en")}")
                                                            </MudText>
                                                        </div>
                                                    </div>
                                                    <MudButton Href="@($"/planner/rounds/{item.Round.Id}/draft")"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Warning"
                                                               Size="Size.Small"
                                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                                        Bekijk
                                                    </MudButton>
                                                </MudPaper>
                                            }

                                            @foreach (var round in staleRounds)
                                            {
                                                <MudPaper Class="pa-3 d-flex align-center justify-space-between flex-wrap gap-2" Outlined="true">
                                                    <div class="d-flex align-center gap-2 flex-wrap">
                                                        <MudIcon Icon="@Icons.Material.Filled.Sync" Color="Color.Error" Size="Size.Small" />
                                                        <div>
                                                            <MudText Typo="Typo.body1"><b>@round.Name</b></MudText>
                                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                                Voorkeuren gewijzigd na aanmaken concept — opnieuw genereren aanbevolen
                                                            </MudText>
                                                        </div>
                                                    </div>
                                                    <MudButton Href="@($"/planner/rounds/{round.Id}/draft")"
                                                               Variant="Variant.Outlined"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                                        Opnieuw genereren
                                                    </MudButton>
                                                </MudPaper>
                                            }

                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }

                        @if (_publishedPlanning)
                        {
                            <MudItem xs="12">
                                <MudCard Elevation="2">
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6" Class="mb-3">Definitieve planning</MudText>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandlePrintPdf"
                                                   EndIcon="@Icons.Material.Filled.PictureAsPdf">
                                            Download als PDF
                                        </MudButton>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }

                        <MudItem xs="12">
                            <MudCard Elevation="2">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Class="mb-3">Planning</MudText>
                                    <MudButton Href="/planner/rounds"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                        Naar planningsrondes
                                    </MudButton>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="12" md="6">
                            <MudCard Elevation="2" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-3">
                                        Reizen zonder reisleiders (@_journeysWithoutTravelLeaders.Count)
                                    </MudText>

                                    @if (_publishedPlanningIsComplete)
                                    {
                                        <AlertModal IsOpen="true"
                                                    Title="Reisplanning compleet"
                                                    Severity="Severity.Success"
                                                    Message="Alle reizen zijn voorzien van reisleiders." />
                                    }
                                    else if (!_journeysWithoutTravelLeaders.Any())
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            Concept is volledig — publiceer de planning om te bevestigen.
                                        </MudText>
                                    }
                                    else
                                    {
                                        <div style="max-height: 200px; overflow-y: auto;" class="pr-2 mb-2">
                                            <MudList T="string" Clickable="false" Dense="true">
                                                @foreach (var journey in _journeysWithoutTravelLeaders)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.EventBusy" IconColor="Color.Warning">
                                                        <div class="d-flex flex-column">
                                                            <MudText Typo="Typo.body1"><b>@journey.Name</b></MudText>
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                                @DateDisplay.FormatDateRange(journey.Start, journey.End)
                                                            </MudText>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider DividerType="DividerType.Inset" />
                                                }
                                            </MudList>
                                        </div>
                                        <MudButton Href="/journeys/create"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   EndIcon="@Icons.Material.Filled.Add">
                                            Nieuwe reis aanmaken
                                        </MudButton>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="12" md="6">
                            <MudCard Elevation="2" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-3">
                                        Reisleiders zonder reis (@_travelLeadersWithoutJourneys.Count)
                                    </MudText>

                                    @if (!_travelLeadersWithoutJourneys.Any())
                                    {
                                        <MudText Typo="Typo.body2" Class="text-muted">
                                            Iedereen is momenteel ingepland.
                                        </MudText>
                                    }
                                    else
                                    {
                                        <div style="height: 190px; overflow-y: auto; overflow-x: hidden;" class="pr-2 mb-2">
                                            <MudList T="string" Dense="true" DisablePadding="true">
                                                @foreach (var leader in _travelLeadersWithoutJourneys)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.PersonOutline" IconColor="Color.Warning" Class="py-0">
                                                        <div style="height: 30px;" class="d-flex align-center">
                                                            <MudText Typo="Typo.body2">@leader.Name</MudText>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider />
                                                }
                                            </MudList>
                                        </div>
                                        <MudButton Href="/travelleaders/create"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   EndIcon="@Icons.Material.Filled.PersonAdd">
                                            Nieuwe reisleider aanmaken
                                        </MudButton>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="12">
                            <MudCard Elevation="2" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Class="mb-3">Notities van reisleiders (@_travelLeadersWithNotes.Count)</MudText>

                                    @if (_travelLeadersWithNotes.Any() == false)
                                    {
                                        <MudText Typo="Typo.body2" Class="text-muted italic">Geen nieuwe opmerkingen gevonden.</MudText>
                                    }
                                    else
                                    {
                                        <div style="height: 230px; overflow-y: auto; overflow-x: hidden;" class="pr-2">
                                            <MudList T="string" Dense="true" DisablePadding="true">
                                                @foreach (var leader in _travelLeadersWithNotes)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.ChatBubbleOutline" IconColor="Color.Primary">
                                                        <div class="d-flex flex-column">
                                                            <MudText Typo="Typo.subtitle2"><b>@leader.TravelLeaderName</b></MudText>
                                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                                @leader.PlanningRoundName
                                                            </MudText>
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary italic">
                                                                "@leader.Note"
                                                            </MudText>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider DividerType="DividerType.Inset" />
                                                }
                                            </MudList>
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>

                </section>
            }

            @if (_isReisleider)
            {
                <section>
                    <h2 class="h5">Gepubliceerde planning</h2>

                    @if (_publishedJourneys.Count == 0)
                    {
                        <div class="text-muted">Er is nog geen gepubliceerde planning zichtbaar.</div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-body p-0">
                                <div class="table-responsive app-table-scroll">
                                    <table class="app-table mb-0 table">
                                        <thead>
                                            <tr>
                                                <th>Land</th>
                                                <th>Periode</th>
                                                <th>Reisleiders</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var journey in _publishedJourneys)
                                            {
                                                <tr>
                                                    <td>@journey.Name</td>
                                                    <td>@DateDisplay.FormatDate(journey.Start) - @DateDisplay.FormatDate(journey.End)</td>
                                                    <td>@FormatTravelLeaders(journey)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </section>
            }
}
