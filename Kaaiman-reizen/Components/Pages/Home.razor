@page "/"

@using Microsoft.AspNetCore.Components.Authorization

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

@if (_isPlanner)
{
    <h1 class="h4">Planning dashboard</h1>
} else
{
    <h1 class="h4">Home</h1>
}

@if (_loading)
{
    <div class="text-muted">Gegevens laden...</div>
}
else
{
    <AuthorizeView>
        <NotAuthorized>
            <div class="alert alert-info">
                Log in om jouw planningsoverzicht te bekijken.
            </div>
        </NotAuthorized>
        <Authorized>
            @if (_notifications.Any())
            {
                <section class="mb-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Notificaties</MudText>
                    @foreach (var notification in _notifications)
                    {
                        <MudAlert Severity="Severity.Info" ShowCloseIcon="true" CloseIconClicked="@(() => MarkNotificationAsRead(notification))" Class="mb-2">
                            @notification.Message
                        </MudAlert>
                    }
                </section>
            }

            @if (_isPlanner)
            {
                <section>
                    <MudGrid Class="mt-1">
                        @if (_publishedPlanning)
                        {
                            <MudItem xs="12">
                                <MudCard Elevation="2">
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6" Class="mb-3">Definitieve planning</MudText>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   OnClick="HandlePrintPdf"
                                                   EndIcon="@Icons.Material.Filled.PictureAsPdf">
                                            Download als PDF
                                        </MudButton>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudCard Elevation="2">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Class="mb-3">Concept planning @(_drafts.Count > 0 ? $"({_drafts.Count})" : "")</MudText>
                                    @if (_drafts.Count == 0)
                                    {
                                        <MudCardActions Class="pl-0">
                                            <MudButton Href="./planner/draft"
                                                       Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       EndIcon="@Icons.Material.Filled.ArrowForward">
                                                Concept aanmaken
                                            </MudButton>
                                        </MudCardActions>
                                    }
                                    else
                                    {
                                        <div style="height: 85px; overflow-y: auto; overflow-x: hidden;" class="pr-2">
                                            <MudList T="object" Clickable="true" DisablePadding="true">
                                                @foreach (var draft in _drafts)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.HistoryEdu"
                                                                 IconColor="Color.Primary"
                                                                 Href="@($"/planner/draft?versionId={draft.Id}")"
                                                                 Class="d-flex align-center py-2"
                                                                 Style="min-height: 50px !important;">
                                                        <div class="d-flex align-center justify-space-between w-100">
                                                            <div class="d-flex flex-column">
                                                                <MudText Typo="Typo.body1"><b>@draft.Name</b></MudText>
                                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                                    Aangemaakt: @draft.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                                                </MudText>
                                                            </div>
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                                                @draft.Assignments.Count toewijzingen
                                                            </MudChip>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider />
                                                }
                                            </MudList>
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="12" md="6">
                            <MudCard Elevation="2" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-3">
                                        Reizen zonder reisleiders (@_journeysWithoutTravelLeaders.Count)
                                    </MudText>

                                    @if (!_journeysWithoutTravelLeaders.Any())
                                    {
                                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                            Alle reizen zijn voorzien van reisleiders.
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        <div style="max-height: 240px; overflow-y: auto;" class="pr-2">
                                            <MudList T="string" Clickable="false" Dense="true">
                                                @foreach (var journey in _journeysWithoutTravelLeaders)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.EventBusy" IconColor="Color.Warning">
                                                        <div class="d-flex flex-column">
                                                            <MudText Typo="Typo.body1"><b>@journey.Name</b></MudText>
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                                @journey.Start.ToString("dd MMM") t/m @journey.End.ToString("dd MMM yyyy")
                                                            </MudText>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider DividerType="DividerType.Inset" />
                                                }
                                            </MudList>
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="12" md="6">
                            <MudCard Elevation="2" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Color="Color.Warning" Class="mb-3">
                                        Reisleiders zonder reis (@_travelLeadersWithoutJourneys.Count)
                                    </MudText>

                                    @if (!_travelLeadersWithoutJourneys.Any())
                                    {
                                        <MudText Typo="Typo.body2" Class="text-muted">
                                            Iedereen is momenteel ingepland.
                                        </MudText>
                                    }
                                    else
                                    {
                                        <div style="height: 230px; overflow-y: auto; overflow-x: hidden;" class="pr-2">
                                            <MudList T="string" Dense="true" DisablePadding="true">
                                                @foreach (var leader in _travelLeadersWithoutJourneys)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.PersonOutline" IconColor="Color.Warning" Class="py-0">
                                                        <div style="height: 30px;" class="d-flex align-center">
                                                            <MudText Typo="Typo.body2">@leader.Name</MudText>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider />
                                                }
                                            </MudList>
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="12">
                            <MudCard Elevation="2" Class="h-100">
                                <MudCardContent>
                                    <MudText Typo="Typo.h6" Class="mb-3">Notities van reisleiders (@_travelLeadersWithNotes.Count)</MudText>

                                    @if (_travelLeadersWithNotes.Any() == false)
                                    {
                                        <MudText Typo="Typo.body2" Class="text-muted italic">Geen nieuwe opmerkingen gevonden.</MudText>
                                    }
                                    else
                                    {
                                        <div style="height: 230px; overflow-y: auto; overflow-x: hidden;" class="pr-2">
                                            <MudList T="string" Dense="true" DisablePadding="true">
                                                @foreach (var leader in _travelLeadersWithNotes)
                                                {
                                                    <MudListItem Icon="@Icons.Material.Filled.ChatBubbleOutline" IconColor="Color.Primary">
                                                        <div class="d-flex flex-column">
                                                            <MudText Typo="Typo.subtitle2"><b>@leader.Name</b></MudText>
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary italic">
                                                                "@leader.Note"
                                                            </MudText>
                                                        </div>
                                                    </MudListItem>
                                                    <MudDivider DividerType="DividerType.Inset" />
                                                }
                                            </MudList>
                                        </div>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>

                </section>
            }

            @if (_isReisleider)
            {
                <section>
                    <h2 class="h5">Gepubliceerde planning</h2>

                    @if (_publishedJourneys.Count == 0)
                    {
                        <div class="text-muted">Er is nog geen gepubliceerde planning zichtbaar.</div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-body p-0">
                                <div class="table-responsive app-table-scroll">
                                    <table class="app-table mb-0 table">
                                        <thead>
                                            <tr>
                                                <th>Land</th>
                                                <th>Periode</th>
                                                <th>Reisleiders</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var journey in _publishedJourneys)
                                            {
                                                <tr>
                                                    <td>@journey.Name</td>
                                                    <td>@journey.Start - @journey.End</td>
                                                    <td>@FormatTravelLeaders(journey)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </section>
            }
        </Authorized>
    </AuthorizeView>
}