@page "/rules"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer

<PageTitle>Regels</PageTitle>

<h1 class="h4 d-flex align-items-center gap-2">Regels
    <Tooltip>
        <strong>Regels — hoe werkt dit?</strong>
        <ul>
            <li>Gebruik de zoekbalk om regels snel op key terug te vinden.</li>
            <li>Pas de waarde of het gewicht direct in de tabel aan.</li>
            <li>Klik op de badge bij "Actief" om een regel aan of uit te zetten.</li>
            <li>Wees voorzichtig: regels kunnen de planner sterk beïnvloeden.</li>
        </ul>
    </Tooltip>
</h1>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <input class="form-control"
                   placeholder="Zoek op key..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
        </div>

            <Table TItem="RuleViewModel" Items="FilteredRules" Path="rules">
            <HeaderContent>
                <th @onclick='() => SortBy("Key")'>
                    Naam @(GetSortIcon("Key"))
                </th>
                <th>
                    Beschrijving
                </th>
                <th>Waarde</th>
                <th>Gewicht</th>
                <th @onclick='() => SortBy("Active")'>
                    Actief @(GetSortIcon("Active"))
                </th>
            </HeaderContent>
            <RowTemplate>
                <td>@context.Key</td>
                <td>
                    @context.Description
                </td>
                <td>
                    @if (HasEditableValue(context))
                    {
                        <input class="form-control form-control-sm"
                               value="@GetRuleValue(context)"
                               @onchange="@(e => UpdateRuleValue(context, (e as ChangeEventArgs)?.Value?.ToString()))" />
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    <input class="form-control form-control-sm"
                           value="@context.Weight"
                           @onchange="@(e => UpdateRuleWeight(context, (e as ChangeEventArgs)?.Value?.ToString()))" />
                </td>
                <td>
                    <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")" style="cursor: pointer;" @onclick="@(() => ToggleActive(context))">
                        @(context.IsActive ? "Ja" : "Nee")
                    </span>
                </td>
            </RowTemplate>
        </Table>

        @if (_rules.Count == 0)
        {
            <div class="text-muted">Geen regels gevonden.</div>
        }
    </div>
</div>