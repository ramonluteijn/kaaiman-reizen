@page "/settings"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer

<PageTitle>Instellingen</PageTitle>

<h1 class="h4 d-flex align-items-center gap-2">Instellingen
    <Tooltip>
        <strong>Regels — hoe werkt dit?</strong>
        <ul>
            <li>Gebruik de zoekbalk om regels snel op key terug te vinden.</li>
            <li>Pas de waarde of het gewicht direct in de tabel aan.</li>
            <li>Klik op de badge bij "Actief" om een regel aan of uit te zetten.</li>
            <li>Wees voorzichtig: regels kunnen de planner sterk beïnvloeden.</li>
        </ul>
    </Tooltip>
</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Planningsregels</h2>

        <div class="mb-3">
            <input class="form-control"
                   placeholder="Zoek op key..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
        </div>

        <Table TItem="RuleViewModel" Items="FilteredRules" Path="settings">
            <HeaderContent>
                <th @onclick='() => SortBy("Key")'>
                    Naam @(GetSortIcon("Key"))
                </th>
                <th>
                    Beschrijving
                </th>
                <th>Waarde</th>
                <th>Gewicht</th>
                <th @onclick='() => SortBy("Active")'>
                    Actief @(GetSortIcon("Active"))
                </th>
            </HeaderContent>
            <RowTemplate>
                <td>@context.Key</td>
                <td>
                    @context.Description
                </td>
                <td>
                    @if (HasEditableValue(context))
                    {
                        <input class="form-control form-control-sm"
                               value="@GetRuleValue(context)"
                               @onchange="@(e => UpdateRuleValue(context, (e as ChangeEventArgs)?.Value?.ToString()))" />
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    <input class="form-control form-control-sm"
                           value="@context.Weight"
                           @onchange="@(e => UpdateRuleWeight(context, (e as ChangeEventArgs)?.Value?.ToString()))" />
                </td>
                <td>
                    <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")" style="cursor: pointer;" @onclick="@(() => ToggleActive(context))">
                        @(context.IsActive ? "Ja" : "Nee")
                    </span>
                </td>
            </RowTemplate>
        </Table>

        @if (!_planningRules.Any())
        {
            <div class="text-muted mt-3">Geen regels gevonden.</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h5">Reisnotificaties</h2>

        <div class="form-check form-switch mb-3">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="journey-reminder-enabled"
                   checked="@_notificationsEnabled"
                   @onchange="OnNotificationsEnabledChanged" />
            <label class="form-check-label" for="journey-reminder-enabled">
                Notificaties versturen
            </label>
        </div>

        <div class="mb-2">
            <label class="form-label" for="journey-reminder-days">Dagen voor vertrek</label>
            <input id="journey-reminder-days"
                   class="form-control"
                   placeholder="Bijv. 7,3"
                   value="@_notificationDaysInput"
                   @onchange="OnReminderDaysChanged"
                   disabled="@(!_notificationsEnabled)" />
            <div class="form-text">Gebruik komma's tussen dagen, bijvoorbeeld 14,7,3.</div>
        </div>
    </div>
</div>
