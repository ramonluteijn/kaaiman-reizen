@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Profiel</PageTitle>

<h1 class="h4 mb-3">Mijn Profiel</h1>

<div class="card">
    <div class="card-body">
        <AuthorizeView>
            <Authorized>
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold">Gebruikersnaam</div>
                    <div class="col-sm-9">@context.User.Identity?.Name</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold">Email</div>
                    <div class="col-sm-9">@GetUserEmail(context.User)</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 fw-bold">Rollen</div>
                    <div class="col-sm-9">
                        @if (GetUserRoles(context.User).Any())
                        {
                            <ul class="list-inline mb-0">
                                @foreach (var role in GetUserRoles(context.User))
                                {
                                    <li class="list-inline-item"><span class="badge" style="background-color: #00796B;">@role</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Geen rollen toegewezen</span>
                        }
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="alert alert-info">
                    Log in om uw profiel te bekijken.
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string GetUserEmail(ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? "Onbekend";
    }

    private IEnumerable<string> GetUserRoles(ClaimsPrincipal user)
    {
        return user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value);
    }
}
