@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Kaaiman_reizen.Data.Identity
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer

<PageTitle>Profiel</PageTitle>

<h1 class="h4 mb-3">Mijn Profiel</h1>

<div class="card">
    <div class="card-body">
        <AuthorizeView>
            <Authorized>
                <div class="profile-details mb-4">
                    <div class="profile-field">
                        <div class="profile-label">Gebruikersnaam</div>
                        <div class="profile-value">@context.User.Identity?.Name</div>
                    </div>
                    <div class="profile-field">
                        <div class="profile-label">Email</div>
                        <div class="profile-value">@GetUserEmail(context.User)</div>
                    </div>
                    <div class="profile-field">
                        <div class="profile-label">Rollen</div>
                        <div class="profile-value">
                        @if (GetUserRoles(context.User).Any())
                        {
                            <ul class="profile-role-list">
                                @foreach (var role in GetUserRoles(context.User))
                                {
                                    <li><span class="badge profile-role-badge">@role</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Geen rollen toegewezen</span>
                        }
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <h2 class="h5 mb-3">Wachtwoord wijzigen</h2>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert alert-@statusColor">@statusMessage</div>
                }

                <EditForm Model="passwordModel" OnValidSubmit="ChangePassword" FormName="changePassword" Context="editContext">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="profile-field mb-3">
                        <label class="profile-label col-form-label">Huidig wachtwoord</label>
                        <div class="profile-value">
                            <InputText type="password" class="form-control" @bind-Value="passwordModel.CurrentPassword" />
                        </div>
                    </div>

                    <div class="profile-field mb-3">
                        <label class="profile-label col-form-label">Nieuw wachtwoord</label>
                        <div class="profile-value">
                            <InputText type="password" class="form-control" @bind-Value="passwordModel.NewPassword" />
                        </div>
                    </div>

                    <div class="profile-field mb-3">
                        <label class="profile-label col-form-label">Bevestig nieuw wachtwoord</label>
                        <div class="profile-value">
                            <InputText type="password" class="form-control" @bind-Value="passwordModel.ConfirmPassword" />
                        </div>
                    </div>

                    <div class="app-form-actions">
                        <button type="submit" class="btn btn-primary">Wijzig wachtwoord</button>
                    </div>
                </EditForm>
            </Authorized>
            <NotAuthorized>
                <div class="alert alert-info">
                    Log in om uw profiel te bekijken.
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
