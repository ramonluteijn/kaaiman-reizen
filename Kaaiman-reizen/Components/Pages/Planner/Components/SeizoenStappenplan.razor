<div class="sp-card">

    <div class="sp-header">
        <div class="sp-header-left">
            <span class="material-icons sp-header-icon">check_box</span>
            <span class="sp-header-title">Stappenplan &mdash; @Model.RondeNaam</span>
            <span class="sp-stap-badge">stap @Model.HuidigStap van @Model.Stappen.Count</span>
        </div>
        <a href="/planner/rounds" class="sp-help-link">
            Alle rondes <span class="material-icons sp-help-icon">arrow_forward</span>
        </a>
    </div>

    <div class="sp-progress-row">
        <span class="sp-progress-label">Voortgang</span>
        <div class="sp-progress-track">
            <div class="sp-progress-fill" style="width: @Model.Voortgang%"></div>
        </div>
        <span class="sp-progress-pct">@Model.Voortgang%</span>
    </div>

    <div class="sp-steps-outer">
        <div class="sp-steps">
            @foreach (var (stap, idx) in Model.Stappen.Select((s, i) => (s, i)))
            {
                var isFirst = idx == 0;
                var isLast = idx == Model.Stappen.Count - 1;
                var prevCompleted = !isFirst && Model.Stappen[idx - 1].Status == StapStatus.Voltooid;
                var selfCompleted = stap.Status == StapStatus.Voltooid;

                var leftCls = isFirst ? "sp-line--hidden" : (prevCompleted ? "sp-line--green" : "sp-line--grey");
                var rightCls = isLast ? "sp-line--hidden" : (selfCompleted ? "sp-line--green" : "sp-line--grey");
                var circleCls = stap.Status switch
                {
                    StapStatus.Voltooid   => "sp-circle--voltooid",
                    StapStatus.Huidig     => "sp-circle--huidig",
                    StapStatus.Aandacht   => "sp-circle--aandacht",
                    _                     => "sp-circle--toekomstig"
                };
                var sublabelCls = stap.SublabelStijl switch
                {
                    SublabelStijl.GroenBadge => "sp-sublabel--groen-badge",
                    SublabelStijl.GrijsBadge => "sp-sublabel--grijs-badge",
                    SublabelStijl.OranjeText => "sp-sublabel--oranje",
                    SublabelStijl.RoodText   => "sp-sublabel--rood",
                    _                        => "sp-sublabel--grijs"
                };
                var knopCls = stap.KnopVariant switch
                {
                    KnopVariant.Gevaar   => "sp-btn--gevaar",
                    KnopVariant.Outlined => "sp-btn--outlined",
                    _                    => "sp-btn--primair"
                };

                <div class="sp-step">
                    <div class="sp-step-head">
                        <div class="sp-line @leftCls"></div>
                        <div class="sp-circle @circleCls">
                            @if (stap.Status == StapStatus.Voltooid)
                            {
                                <span class="material-icons sp-check-icon">check</span>
                            }
                            else
                            {
                                @stap.Nummer
                            }
                        </div>
                        <div class="sp-line @rightCls"></div>
                    </div>

                    <div class="sp-step-body">
                        <div class="sp-step-title @(stap.Status == StapStatus.Huidig ? "sp-step-title--active" : "")">
                            @stap.Titel
                        </div>
                        @if (!string.IsNullOrEmpty(stap.Sublabel))
                        {
                            <div class="sp-sublabel @sublabelCls">@stap.Sublabel</div>
                        }
                        @if (stap.KnopTekst is not null)
                        {
                            @if (stap.KnopHref is not null)
                            {
                                <a href="@stap.KnopHref" class="sp-btn @knopCls">@stap.KnopTekst</a>
                            }
                            else
                            {
                                <button class="sp-btn @knopCls">@stap.KnopTekst</button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

</div>
