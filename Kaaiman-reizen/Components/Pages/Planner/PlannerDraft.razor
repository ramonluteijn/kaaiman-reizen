@page "/planner/draft"
@rendermode InteractiveServer

<PageTitle>Draft Planning</PageTitle>

<MudStack Spacing="4" Class="pa-4">
    <MudText Typo="Typo.h5">Planner Draft Dashboard</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_request != null)
    {
        <!-- Generate button -->
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="GenerateDraftAsync" Disabled="@_isGenerating">
                @if (_isGenerating)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Bezig met genereren...</MudText>
                }
                else
                {
                    <MudText>Genereer Draft Planning</MudText>
                }
            </MudButton>
        </div>

        @if (_isGenerating)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                OR-Tools optimaliseert de planning...
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            </MudAlert>
        }
        else if (_result != null)
        {
            if (_result.IsSuccess)
            {
                var totalMatches = _result.JourneyAssignments.Values.SelectMany(l => l).Count();
                var leaderRows   = BuildLeaderRows();
                var inPlanning   = leaderRows.Where(r => r.AssignedJourneys.Count > 0).ToList();
                var notInPlanning = leaderRows.Where(r => r.AssignedJourneys.Count == 0).ToList();

                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4">
                    Planning gegenereerd — @totalMatches toewijzingen gevonden.
                </MudAlert>

                <!-- Assignment cards: one card per journey, leaders listed inside -->
                <MudStack Spacing="3">
                    @foreach (var kvp in _result.JourneyAssignments)
                    {
                        var journeyAssignments = kvp.Value;
                        var journey = _request.Journeys.First(j => j.Id == kvp.Key);

                        <MudPaper Class="pa-4" Elevation="1">
                            <MudGrid>
                                <MudItem xs="12" sm="5">
                                    <MudText Typo="Typo.h6">@journey.Country</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth"
                                                 Size="Size.Small" Class="mr-1 mb-n1" />
                                        @journey.Start.ToString("dd MMM yyyy") – @journey.End.ToString("dd MMM yyyy")
                                    </MudText>
                                    @if (journey.RequiredLeaders > 1)
                                    {
                                        <MudChip T="string" Size="Size.Small" Class="mt-1"
                                                 Color="Color.Info" Variant="Variant.Outlined">
                                            Vereist: @journey.RequiredLeaders reisleiders
                                        </MudChip>
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="7">
                                    <MudStack Spacing="1">
                                        @foreach (var assignment in journeyAssignments)
                                        {
                                            <div class="d-flex align-center gap-2 flex-wrap">
                                                <MudText Typo="Typo.subtitle2">@assignment.LeaderName</MudText>
                                                @if (assignment.RankMatched.HasValue)
                                                {
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@(assignment.RankMatched == 1 ? Color.Success
                                                                     : assignment.RankMatched == 2 ? Color.Info
                                                                     : Color.Warning)">
                                                        Keuze #@assignment.RankMatched
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small">Geen voorkeur</MudChip>
                                                }
                                            </div>
                                        }
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>

                <!-- Calendar preview -->
                <MudText Typo="Typo.h6" Class="mt-6 mb-2">Kalenderoverzicht</MudText>

                <CalendarView Journeys="BuildCalendarJourneys()"
                              OnJourneyClick="HandleJourneyClick" />

                <!-- Leader overview -->
                <MudText Typo="Typo.h6" Class="mt-6 mb-2">Reisleiders overzicht</MudText>
                <MudGrid>
                    <!-- In de planning -->
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-1 mb-n1" Size="Size.Small" />
                            In de planning (@inPlanning.Count)
                        </MudText>
                        <MudStack Spacing="2">
                            @foreach (var row in inPlanning)
                            {
                                <MudPaper Class="pa-3" Elevation="1"
                                          Style="border-left: 4px solid var(--mud-palette-success);">
                                    <MudText Typo="Typo.subtitle2"><b>@row.LeaderName</b></MudText>
                                    <MudStack Spacing="1" Class="mt-1">
                                        @foreach (var item in row.AssignedJourneys)
                                        {
                                            <div class="d-flex align-center gap-2 flex-wrap">
                                                <MudText Typo="Typo.body2">
                                                    @item.Journey.Country
                                                    <span class="text-secondary ms-1">
                                                        (@item.Journey.Start.ToString("dd MMM") – @item.Journey.End.ToString("dd MMM yyyy"))
                                                    </span>
                                                </MudText>
                                                @if (item.RankMatched.HasValue)
                                                {
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@(item.RankMatched == 1 ? Color.Success
                                                                     : item.RankMatched == 2 ? Color.Info
                                                                     : Color.Warning)">
                                                        Keuze #@item.RankMatched
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Geen voorkeur</MudChip>
                                                }
                                            </div>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudItem>

                    <!-- Niet in de planning -->
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Warning" Class="mr-1 mb-n1" Size="Size.Small" />
                            Niet in de planning (@notInPlanning.Count)
                        </MudText>
                        @if (notInPlanning.Count == 0)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                Alle reisleiders zijn toegewezen.
                            </MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var row in notInPlanning)
                                {
                                    <MudPaper Class="pa-3" Elevation="1"
                                              Style="border-left: 4px solid var(--mud-palette-warning);">
                                        <MudText Typo="Typo.subtitle2"><b>@row.LeaderName</b></MudText>
                                        @if (row.Preferences.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var pref in row.Preferences.OrderBy(p => p.Value))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                        @pref.Key (#@pref.Value)
                                                    </MudChip>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Geen voorkeuren opgegeven</MudText>
                                        }
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    <b>Genereren mislukt:</b> @_result.ErrorMessage
                </MudAlert>
            }
        }
    }
</MudStack>

<!-- ── Journey detail drawer ───────────────────────────────────── -->

@* Backdrop — clicking it closes the drawer *@
<div class="jd-overlay @(_drawerOpen ? "jd-overlay--visible" : "")"
     @onclick="CloseDrawer"></div>

<aside class="jd-drawer @(_drawerOpen ? "jd-drawer--open" : "")">
    @if (_selectedJourney is not null)
    {
        var candidates    = GetCandidatesFor(_selectedJourney);
        var assignedCount = _selectedJourney.TravelLeaders.Count;
        var required      = _selectedJourney.RequiredLeaders;
        var isFull        = assignedCount >= required;

        <!-- Header -->
        <div class="jd-header">
            <div class="jd-header-text">
                <span class="jd-header-title">@_selectedJourney.Country</span>
                <span class="jd-header-dates">
                    @_selectedJourney.Start.ToString("dd MMM yyyy") – @_selectedJourney.End.ToString("dd MMM yyyy")
                </span>
            </div>
            <button class="jd-close-btn" @onclick="CloseDrawer" aria-label="Sluiten">
                <span class="material-icons">close</span>
            </button>
        </div>

        <div class="jd-divider"></div>

        <!-- Scrollable body -->
        <div class="jd-body">

            <!-- ── Section 1: Assigned leaders ── -->
            <div class="jd-section-header">
                <p class="jd-section-label">Toegewezen reisleiders</p>
                <span class="jd-required-badge @(isFull ? "jd-required-badge--ok" : "jd-required-badge--gap")">
                    @assignedCount / @required
                    <span class="material-icons" style="font-size:0.85rem; margin-left:2px;">
                        @(isFull ? "check_circle" : "warning_amber")
                    </span>
                </span>
            </div>

            @if (_selectedJourney.TravelLeaders.Any())
            {
                <div class="jd-leader-list">
                    @foreach (var leader in _selectedJourney.TravelLeaders)
                    {
                        <div class="jd-leader-card">
                            <div class="jd-avatar">@leader.Name[0]</div>
                            <span class="jd-leader-name">@leader.Name</span>
                            <button class="jd-remove-btn" @onclick="() => RemoveLeader(leader)"
                                    title="Verwijder reisleider">
                                <span class="material-icons">person_remove</span>
                                Verwijderen
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="jd-no-leader">
                    <span class="material-icons jd-no-leader-icon">warning_amber</span>
                    <span>Geen reisleider toegewezen.</span>
                </div>
            }

            <div class="jd-divider" style="margin: 18px 0;"></div>

            <!-- ── Section 2: Available candidates ── -->
            <div class="jd-section-header">
                <p class="jd-section-label">Beschikbare reisleiders</p>
                <span class="jd-count-badge">@candidates.Count</span>
            </div>

            @if (candidates.Count == 0)
            {
                <div class="jd-no-leader">
                    <span class="material-icons">group_off</span>
                    <span>Geen reisleiders beschikbaar voor deze reisdatums.</span>
                </div>
            }
            else
            {
                <div class="jd-alt-list">
                    @foreach (var c in candidates)
                    {
                        <div class="jd-alt-row @(c.IsAlreadyAssigned ? "jd-alt-row--assigned" : "")">
                            <!-- Avatar + name + preference badge -->
                            <div class="jd-alt-row-main">
                                <div class="jd-avatar jd-avatar--sm">@c.LeaderName[0]</div>
                                <div class="jd-alt-info">
                                    <span class="jd-alt-name">@c.LeaderName</span>
                                    <div class="jd-alt-badges">
                                        @if (c.PreferenceRank.HasValue)
                                        {
                                            <span class="jd-pref-badge jd-pref-badge--@c.PreferenceRank">
                                                Keuze @c.PreferenceRank
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="jd-pref-badge jd-pref-badge--none">Geen voorkeur</span>
                                        }
                                    </div>
                                    <!-- Warning chips -->
                                    @if (c.HasConflict)
                                    {
                                        <div class="jd-warn-chip jd-warn-chip--conflict">
                                            <span class="material-icons" style="font-size:0.85rem;">swap_horiz</span>
                                            Overlapt: @c.ConflictJourneyName
                                        </div>
                                    }
                                    @if (c.ExceedsMaxTrips)
                                    {
                                        <div class="jd-warn-chip jd-warn-chip--maxtrips">
                                            <span class="material-icons" style="font-size:0.85rem;">block</span>
                                            Max trips bereikt (@c.CurrentAssignments/@c.MaxTrips)
                                        </div>
                                    }
                                </div>
                            </div>
                            <!-- Action button -->
                            @if (c.IsAlreadyAssigned)
                            {
                                <span class="jd-already-check" title="Al toegewezen">
                                    <span class="material-icons">check</span>
                                </span>
                            }
                            else if (isFull)
                            {
                                <span class="jd-assign-btn jd-assign-btn--disabled"
                                      title="Limiet bereikt (@required/@required reisleiders)">
                                    <span class="material-icons">lock</span>
                                </span>
                            }
                            else
                            {
                                <button class="jd-assign-btn" @onclick="() => AssignLeader(c)"
                                        title="Wijs toe">
                                    <span class="material-icons">person_add</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</aside>

<style>
    /* ── Overlay ──────────────────────────────────────────────── */
    .jd-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1200;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
    }
    .jd-overlay--visible {
        opacity: 1;
        pointer-events: all;
    }

    /* ── Drawer panel ─────────────────────────────────────────── */
    .jd-drawer {
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        width: 380px;
        max-width: 92vw;
        background: #ffffff;
        box-shadow: -4px 0 28px rgba(0, 0, 0, 0.14);
        z-index: 1201;
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 16px 0 0 16px;
    }
    .jd-drawer--open { transform: translateX(0); }

    /* ── Header ───────────────────────────────────────────────── */
    .jd-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 20px 20px 16px;
        gap: 12px;
        flex-shrink: 0;
    }
    .jd-header-text { display: flex; flex-direction: column; gap: 4px; }
    .jd-header-title { font-size: 1.2rem; font-weight: 700; color: #1a1a2e; line-height: 1.2; }
    .jd-header-dates { font-size: 0.82rem; color: #64748b; }
    .jd-close-btn {
        flex-shrink: 0; width: 34px; height: 34px; border: none; border-radius: 50%;
        background: #f1f5f9; cursor: pointer; display: flex; align-items: center;
        justify-content: center; transition: background 0.15s;
    }
    .jd-close-btn:hover { background: #e2e8f0; }
    .jd-close-btn .material-icons { font-size: 1.1rem; color: #475569; }

    /* ── Divider ──────────────────────────────────────────────── */
    .jd-divider { height: 1px; background: #e2e8f0; margin: 0 20px; flex-shrink: 0; }

    /* ── Body (scrollable) ────────────────────────────────────── */
    .jd-body { padding: 18px 20px; flex: 1; overflow-y: auto; min-height: 0; }

    /* ── Section headers ──────────────────────────────────────── */
    .jd-section-header {
        display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
    }
    .jd-section-label {
        font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em;
        text-transform: uppercase; color: #94a3b8; margin: 0;
    }

    /* ── Required-leaders badge ───────────────────────────────── */
    .jd-required-badge {
        display: inline-flex; align-items: center; gap: 2px;
        padding: 2px 9px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;
    }
    .jd-required-badge--ok  { background: #dcfce7; color: #166534; }
    .jd-required-badge--gap { background: #fef9c3; color: #713f12; }

    /* ── Count badge (candidates) ─────────────────────────────── */
    .jd-count-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; border-radius: 50%;
        background: #e2e8f0; color: #475569; font-size: 0.7rem; font-weight: 700;
    }

    /* ── Assigned leader list ─────────────────────────────────── */
    .jd-leader-list { display: flex; flex-direction: column; gap: 8px; }
    .jd-leader-card {
        display: flex; align-items: center; gap: 12px; padding: 12px 14px;
        border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0;
    }
    .jd-avatar {
        width: 40px; height: 40px; border-radius: 50%;
        background: linear-gradient(135deg, #1976d2, #42a5f5);
        color: #fff; font-size: 1rem; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; text-transform: uppercase;
    }
    .jd-avatar--sm { width: 32px; height: 32px; font-size: 0.85rem; }
    .jd-leader-name { flex: 1; font-weight: 600; font-size: 0.92rem; color: #1e293b; }

    /* ── Remove button ────────────────────────────────────────── */
    .jd-remove-btn {
        display: flex; align-items: center; gap: 4px; padding: 5px 10px;
        border: 1.5px solid #ef4444; border-radius: 8px; background: transparent;
        color: #ef4444; font-size: 0.75rem; font-weight: 600;
        cursor: pointer; transition: background 0.15s, color 0.15s; white-space: nowrap;
    }
    .jd-remove-btn:hover { background: #ef4444; color: #fff; }
    .jd-remove-btn .material-icons { font-size: 0.95rem; }

    /* ── No-leader / empty state ──────────────────────────────── */
    .jd-no-leader {
        display: flex; align-items: center; gap: 10px; padding: 12px 14px;
        border-radius: 12px; background: #fffbeb; border: 1px solid #fde68a;
        color: #92400e; font-size: 0.85rem; font-weight: 500;
    }
    .jd-no-leader-icon { color: #f59e0b; font-size: 1.2rem; }

    /* ── Candidate list ───────────────────────────────────────── */
    .jd-alt-list { display: flex; flex-direction: column; gap: 8px; }
    .jd-alt-row {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 10px; padding: 12px 14px; border-radius: 12px;
        background: #f8fafc; border: 1px solid #e2e8f0;
        transition: background 0.12s;
    }
    .jd-alt-row--assigned { background: #f0fdf4; border-color: #bbf7d0; }
    .jd-alt-row-main { display: flex; align-items: flex-start; gap: 10px; flex: 1; min-width: 0; }
    .jd-alt-info { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
    .jd-alt-name { font-weight: 600; font-size: 0.88rem; color: #334155; }
    .jd-alt-badges { display: flex; flex-wrap: wrap; gap: 4px; }

    /* ── Preference rank badges ───────────────────────────────── */
    .jd-pref-badge {
        padding: 2px 8px; border-radius: 20px; font-size: 0.7rem;
        font-weight: 700; white-space: nowrap;
    }
    .jd-pref-badge--1    { background: #dcfce7; color: #166534; }
    .jd-pref-badge--2    { background: #dbeafe; color: #1e40af; }
    .jd-pref-badge--3    { background: #fef9c3; color: #713f12; }
    .jd-pref-badge--none { background: #f1f5f9; color: #94a3b8; }

    /* ── Warning chips ────────────────────────────────────────── */
    .jd-warn-chip {
        display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px;
        border-radius: 10px; font-size: 0.7rem; font-weight: 600;
    }
    .jd-warn-chip--conflict { background: #fef3c7; color: #92400e; }
    .jd-warn-chip--maxtrips { background: #fee2e2; color: #991b1b; }

    /* ── Assign button ────────────────────────────────────────── */
    .jd-assign-btn {
        flex-shrink: 0; width: 32px; height: 32px; border: none;
        border-radius: 8px; background: #dcfce7; color: #16a34a;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: background 0.15s, color 0.15s;
    }
    .jd-assign-btn:hover { background: #16a34a; color: #fff; }
    .jd-assign-btn .material-icons { font-size: 1.1rem; }
    /* Locked state — limit reached */
    .jd-assign-btn--disabled {
        background: #f1f5f9; color: #cbd5e1; cursor: not-allowed;
        pointer-events: none;
    }

    /* ── Already-assigned checkmark ──────────────────────────── */
    .jd-already-check {
        flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px;
        background: #f0fdf4; color: #16a34a;
        display: flex; align-items: center; justify-content: center;
    }
    .jd-already-check .material-icons { font-size: 1.1rem; }
</style>
