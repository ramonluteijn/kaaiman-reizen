@page "/planner/draft"
@rendermode InteractiveServer
@using Kaaiman_reizen.Components.Pages.Planner.Components

<PageTitle>Draft Planning</PageTitle>

<MudStack Spacing="4" Class="pa-4 pd-page">
    <MudText Typo="Typo.h5">Planner</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_request != null)
    {
        @if (_showEntryModal)
        {
            <EntryModal 
                ActionInProgress="_entryActionInProgress"
                AvailableDrafts="_availableDrafts"
                @bind-SelectedDraftId="_selectedDraftId"
                OnGenerateNew="GenerateNewPlanningFromModalAsync"
                OnResumeDraft="ResumeSelectedDraftAsync" />
        }

        @if (!_showEntryModal)
        {
        @if (!string.IsNullOrWhiteSpace(_saveMessage)
             && !_saveMessage.StartsWith("Concept geladen", System.StringComparison.OrdinalIgnoreCase))
        {
            <MudAlert Severity="@_saveMessageSeverity" Variant="Variant.Outlined" Dense="true">
                @_saveMessage
            </MudAlert>
        }

        @if (_isGenerating)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                OR-Tools optimaliseert de planning...
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            </MudAlert>
        }
        else if (_result != null)
        {
            if (_result.IsSuccess)
            {
                var leaderRows   = BuildLeaderRows();
                var inPlanning   = leaderRows.Where(r => r.AssignedJourneys.Count > 0).ToList();
                var notInPlanning = leaderRows.Where(r => r.AssignedJourneys.Count == 0).ToList();

                <!-- Calendar preview -->
                <CalendarView Journeys="BuildCalendarJourneys()"
                              OnJourneyClick="HandleJourneyClick" />

                <!-- Leader overview -->
                <MudText Typo="Typo.h6" Class="mt-6 mb-2">Reisleiders overzicht</MudText>
                <MudGrid>
                    <!-- In de planning -->
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-1 mb-n1" Size="Size.Small" />
                            In de planning (@inPlanning.Count)
                        </MudText>
                        <MudStack Spacing="2">
                            @foreach (var row in inPlanning)
                            {
                                <MudPaper Class="pa-3" Elevation="1"
                                          Style="border-left: 4px solid var(--mud-palette-success);">
                                    <MudText Typo="Typo.subtitle2"><b>@row.LeaderName</b></MudText>
                                    <MudStack Spacing="1" Class="mt-1">
                                        @foreach (var item in row.AssignedJourneys)
                                        {
                                            <div class="d-flex align-center gap-2 flex-wrap">
                                                <MudText Typo="Typo.body2">
                                                    @item.Journey.Name
                                                    <span class="text-secondary ms-1">
                                                        (@item.Journey.Start.ToString("dd MMM") – @item.Journey.End.ToString("dd MMM yyyy"))
                                                    </span>
                                                </MudText>
                                                @if (item.RankMatched.HasValue)
                                                {
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@(item.RankMatched == 1 ? Color.Success
                                                                     : item.RankMatched == 2 ? Color.Info
                                                                     : Color.Warning)">
                                                        Keuze #@item.RankMatched
                                                    </MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Geen voorkeur</MudChip>
                                                }
                                            </div>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudItem>

                    <!-- Niet in de planning -->
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Warning" Class="mr-1 mb-n1" Size="Size.Small" />
                            Niet in de planning (@notInPlanning.Count)
                        </MudText>
                        @if (notInPlanning.Count == 0)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                Alle reisleiders zijn toegewezen.
                            </MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var row in notInPlanning)
                                {
                                    <MudPaper Class="pa-3" Elevation="1"
                                              Style="border-left: 4px solid var(--mud-palette-warning);">
                                        <MudText Typo="Typo.subtitle2"><b>@row.LeaderName</b></MudText>
                                        @if (row.Preferences.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var pref in row.Preferences.OrderBy(p => p.Value))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                        @pref.Key (#@pref.Value)
                                                    </MudChip>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Geen voorkeuren opgegeven</MudText>
                                        }
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudItem>
                </MudGrid>

                <div class="pd-bottom-actions">
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@_isSaving"
                                   OnClick="SaveDraftAsync">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Bezig met opslaan...</MudText>
                            }
                            else
                            {
                                <MudText>Opslaan als concept</MudText>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@_isSaving"
                                   OnClick="PublishPlanningAsync">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Bezig met opslaan...</MudText>
                            }
                            else
                            {
                                <MudText>Publiceer planning</MudText>
                            }
                        </MudButton>
                    </div>
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                    <b>Genereren mislukt:</b> @_result.ErrorMessage
                </MudAlert>
            }
        }
        }
    }
</MudStack>

<!-- ── Journey detail drawer ───────────────────────────────────── -->

<JourneyDetailDrawer 
    IsOpen="_drawerOpen"
    SelectedJourney="_selectedJourney"
    Candidates="GetCandidatesFor(_selectedJourney)"
    OnClose="CloseDrawer"
    OnAssignLeader="AssignLeader"
    OnRemoveLeader="RemoveLeader" />


