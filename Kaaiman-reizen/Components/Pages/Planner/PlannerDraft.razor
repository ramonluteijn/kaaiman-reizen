@page "/planner/draft"

@using Kaaiman_reizen.Components.Pages.Planner.Components;
@using Kaaiman_reizen.Data.Enum;

@rendermode InteractiveServer

@using Kaaiman_reizen.Components.Pages.Planner.Components
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Planner")]

<PageTitle>Draft Planning</PageTitle>

<MudStack Spacing="4" Class="pa-4 pd-page">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
        <MudText Typo="Typo.h5">Planner</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   Disabled="@_isSaving"
                   OnClick="OpenArchiveAvailabilityDialog">
            Nieuwe planningsperiode starten
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_request != null)
    {
        @if (!string.IsNullOrWhiteSpace(_saveMessage))
        {
            <AlertModal IsOpen="true"
                        Title="Melding"
                        Severity="@_saveMessageSeverity"
                        Message="@_saveMessage" />
        }

        @if (_isGenerating)
        {
            <AlertModal IsOpen="true"
                        Title="Planning genereren"
                        Severity="Severity.Info"
                        Dismissible="false"
                        CloseOnBackdropClick="false">
                <MudText Typo="Typo.body1">
                    OR-Tools optimaliseert de planning...
                </MudText>
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            </AlertModal>
        }
        else if (_result != null)
        {
            if (_result.IsSuccess)
            {
                var leaderRows = BuildLeaderRows();

                @if (_preferenceChangesDetected)
                {
                    <MudAlert Severity="Severity.Warning"
                              ShowCloseIcon="true"
                              CloseIconClicked="@(() => _preferenceChangesDetected = false)"
                              Class="mb-2">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <MudText Typo="Typo.body2">Reisleiders hebben hun voorkeuren bijgewerkt. Genereer opnieuw om de planning bij te werken.</MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       Disabled="@_isSaving"
                                       OnClick="@(() => RegeneratePlanningAsync())">
                                Opnieuw genereren
                            </MudButton>
                        </div>
                    </MudAlert>
                }
                
                <!-- Sidebar & planning mode buttons-->
                <div class="d-flex justify-content-between">
                    <div class="d-flex align-center mb-2 gap-2">
                        <MudIconButton Icon="@Icons.Material.Filled.People"
                                    Size="Size.Small"
                                    Variant="Variant.Outlined"
                                    Color="@(_sidebarOpen ? Color.Primary : Color.Default)"
                                    OnClick="@(() => _sidebarOpen = !_sidebarOpen)"
                                    title="Reisleiders tonen/verbergen" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Reisleiders</MudText>
                    </div>
                    <MudToggleGroup T="CalendarModes" @bind-Value="selectedMode" SelectionMode="SelectionMode.SingleSelection">
                        <MudToggleItem Value="@CalendarModes.JourneyMode">Reizen</MudToggleItem>
                        <MudToggleItem Value="@CalendarModes.AvailibilityPeriodMode">Beschikbaarheden</MudToggleItem>
                    </MudToggleGroup>
                </div>

                <!-- Calendar + sidebar layout -->
                <div class="pd-layout">

                    @if (_sidebarOpen)
                    {
                        <aside class="pd-sidebar">
                            <p class="pd-sidebar-title">Reisleiders (@leaderRows.Count)</p>
                            @foreach (var row in leaderRows)
                            {
                                var hasJourneys = row.AssignedJourneys.Count > 0;
                                <div class="pd-sidebar-row @(hasJourneys ? "pd-sidebar-row--assigned" : "pd-sidebar-row--unassigned") position-relative">
                                    <div class="pd-sidebar-avatar">@row.LeaderName[0]</div>

                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   class="position-absolute end-0 top-0"
                                                   Style="z-index: 2;"
                                                   title="Reisleider details"
                                                   OnClick="@(() => OpenLeaderDetails(row))"
                                    />

                                    <div class="pd-sidebar-info">
                                        <span class="pd-sidebar-name">@row.LeaderName</span>
                                        @if (hasJourneys)
                                        {
                                            <span class="pd-sidebar-count">@row.AssignedJourneys.Count rei@(row.AssignedJourneys.Count == 1 ? "s" : "zen")</span>
                                            <div class="pd-sidebar-journeys">
                                                @foreach (var item in row.AssignedJourneys)
                                                {
                                                    <div class="pd-sidebar-journey">
                                                        <span class="pd-sidebar-journey-name">@item.Journey.Name</span>
                                                        <span class="pd-sidebar-journey-dates">@DateDisplay.FormatDateRange(item.Journey.Start, item.Journey.End)</span>
                                                        @if (item.RankMatched.HasValue)
                                                        {
                                                            <span class="pd-sidebar-rank pd-sidebar-rank--@(item.RankMatched == 1 ? "1" : item.RankMatched == 2 ? "2" : "3")">
                                                                #@item.RankMatched
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="pd-sidebar-count pd-sidebar-count--none">Niet ingepland</span>
                                            @if (row.Preferences.Count > 0)
                                            {
                                                <div class="pd-sidebar-prefs">
                                                    @foreach (var pref in row.Preferences.OrderBy(p => p.Rank))
                                                    {
                                                        <span class="pd-sidebar-pref">@pref.JourneyTitle (#@pref.Rank)</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="pd-sidebar-no-prefs">Nog geen voorkeuren ingevuld</span>
                                            }
                                        }

    <AlertModal IsOpen="@_archiveDialogOpen"
                IsOpenChanged="HandleArchiveDialogChanged"
                Title="Nieuwe planningsperiode starten"
                Severity="Severity.Warning"
                Dismissible="true"
                CloseOnBackdropClick="true"
                Message="Weet je zeker dat je een nieuwe periode wilt starten? Alle beschikbaarheid wordt gearchiveerd en gereset.">
        <Actions>
            <MudButton Variant="Variant.Text" OnClick="CloseArchiveDialog">
                Annuleren
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmArchiveAsync">
                Bevestigen
            </MudButton>
        </Actions>
    </AlertModal>
                                    </div>
                                </div>
                            }
                        </aside>
                    }

                    <div class="pd-main">
                        @if (_result.JourneyWarnings.Any())
                        {
                            <AlertModal IsOpen="true"
                                        Title="Waarschuwingen"
                                        Severity="Severity.Warning">
                                <MudStack Spacing="1">
                                @foreach (var kvp in _result.JourneyWarnings)
                                {
                                    var warnedJourney = _request!.Journeys.FirstOrDefault(j => j.Id == kvp.Key);
                                    if (warnedJourney is null) continue;
                                    <MudPaper Class="pa-3" Outlined="true">
                                        <MudText Typo="Typo.subtitle2">@warnedJourney.Name</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            @DateDisplay.FormatDateRange(warnedJourney.Start, warnedJourney.End)
                                        </MudText>
                                        <MudText Typo="Typo.body2" Class="mt-1">@kvp.Value</MudText>
                                    </MudPaper>
                                }
                                </MudStack>
                            </AlertModal>
                        }

                        <CalendarView Mode="@selectedMode" Journeys="BuildCalendarJourneys()" AvailabilityPeriods="_availibilityPeriods" OnJourneyClick="HandleJourneyClick" />

                    </div>
                </div>

                <div class="pd-bottom-actions">
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Disabled="@_isSaving"
                                   OnClick="@(() => RegeneratePlanningAsync())">
                            Opnieuw genereren
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@_isSaving"
                                   OnClick="SaveDraftAsync">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Bezig met opslaan...</MudText>
                            }
                            else
                            {
                                <MudText>Opslaan als concept</MudText>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(_isSaving || !CanPublish)"
                                   OnClick="PublishPlanningAsync">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Bezig met opslaan...</MudText>
                            }
                            else
                            {
                                <MudText>Publiceer planning</MudText>
                            }
                        </MudButton>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(_result.ErrorMessage))
            {
                <AlertModal IsOpen="true"
                            Title="Genereren mislukt"
                            Severity="Severity.Error"
                            Message="@_result.ErrorMessage" />
            }
        }
    }
</MudStack>

<NoteModal
    IsOpen="_noteModalOpen"
    Leader="_selectedLeaderRow?.Leader"
    AssignedJourneys="GetSelectedLeaderJourneys()"
    OnClose="CloseLeaderDetails" />
<JourneyDrawer
    IsOpen="_drawerOpen"
    SelectedJourney="_selectedJourney"
    Candidates="_selectedCandidates"
    OnClose="CloseDrawer"
    OnAssignLeader="AssignLeader"
    OnRemoveLeader="RemoveLeader" />
}