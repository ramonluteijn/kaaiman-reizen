@page "/accountmanagement"
@using Microsoft.AspNetCore.Authorization
@using Kaaiman_reizen.Data.Identity
@using Kaaiman_reizen.Data.Services;

@attribute [Authorize(Roles = "Planner")]
@rendermode InteractiveServer

@inject IJSRuntime JS
@inject AccountService AccountService

<PageTitle>Gebruikersbeheer</PageTitle>

<h1 class="h4">Gebruikersbeheer</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <input class="form-control w-25"
        placeholder="Zoek een gebruiker"
        @bind="_searchTerm"
        @bind:event="oninput" />
</div>

<h4>Filter op e-mailadres</h4>

@* <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error">Delete</MudButton> *@

@foreach (var account in FilteredAccounts)
{
    <h4>@account.Email</h4>
}

@code {
    private List<ApplicationUser> _accounts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await AccountService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Fout bij laden users: {ex.Message}");
        }
    }

    private string _searchTerm = string.Empty;
    private IEnumerable<ApplicationUser> FilteredAccounts => AccountService.GetMatchingUsers(_accounts, _searchTerm);
}

