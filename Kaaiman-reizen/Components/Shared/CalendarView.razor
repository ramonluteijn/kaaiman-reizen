@using Kaaiman_reizen.Data.Entities
@using Kaaiman_reizen.Models.ViewModels

<MudPaper Elevation="1" Class="pa-4">
    <div class="cal-nav-block">
        <div class="cal-nav-row">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PrevMonth" />
            <div class="cal-nav-center">
                <MudText Typo="Typo.h5">@_currentDate.ToString("MMMM yyyy")</MudText>
                @if (Journeys.Any())
                {
                    <div class="cal-pills-bar">
                        @foreach (var group in Journeys
                            .OrderBy(j => j.Start)
                            .GroupBy(j => new { j.Start.Year, j.Start.Month }))
                        {
                            var monthDate = new DateOnly(group.Key.Year, group.Key.Month, 1);
                            var isActive  = _currentDate.Year == group.Key.Year && _currentDate.Month == group.Key.Month;

                            <div class="cal-pill-group">
                                <button class="cal-month-pill @(isActive ? "cal-pill-active" : "")"
                                        @onclick="() => GoToMonth(monthDate)">
                                    @monthDate.ToString("MMM yyyy")
                                </button>
                                <div class="cal-pill-chips">
                                    @foreach (var j in group)
                                    {
                                        <span class="cal-journey-chip" @onclick="() => GoToMonth(j.Start)">
                                            @j.Country
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" />
        </div>
    </div>

    <!-- Day name headers -->
    <div class="cal-header-row">
        <div class="cal-header">Ma</div>
        <div class="cal-header">Di</div>
        <div class="cal-header">Wo</div>
        <div class="cal-header">Do</div>
        <div class="cal-header">Vr</div>
        <div class="cal-header">Za</div>
        <div class="cal-header">Zo</div>
    </div>

    <!-- 6 week rows -->
    @for (int w = 0; w < 6; w++)
    {
        var weekDays   = _days.Skip(w * 7).Take(7).ToList();
        var weekStart  = weekDays[0].Date;
        var weekEnd    = weekDays[6].Date;

        // Journeys that are visible at all in this week
        var weekJourneys = Journeys
            .Where(j => j.Start <= weekEnd && j.End >= weekStart)
            .ToList();

        <div class="cal-week">
            <!-- Row 1: day number cells, one per column -->
            @foreach (var day in weekDays)
            {
                var isCurrentMonth = day.Date.Month == _currentDate.Month;
                var isToday        = day.Date == DateOnly.FromDateTime(DateTime.Today);
                <div class="cal-day-cell @(isCurrentMonth ? "" : "other-month") @(isToday ? "today-highlight" : "")">
                    <div class="day-number">@day.Date.Day</div>
                </div>
            }

            <!-- Row 2+: journey bars spanning their columns within this week.
                 A journey that starts before this week begins at column 1 (clipped left).
                 A journey that ends after this week ends at column 7 (clipped right).
                 border-radius is removed on the clipped side to signal continuation. -->
            @foreach (var journey in weekJourneys)
            {
                var clippedStart   = journey.Start < weekStart ? weekStart : journey.Start;
                var clippedEnd     = journey.End   > weekEnd   ? weekEnd   : journey.End;
                var startCol       = GetDayColumn(clippedStart);
                var spanCols       = clippedEnd.DayNumber - clippedStart.DayNumber + 1;
                var continuesLeft  = journey.Start < weekStart;
                var continuesRight = journey.End   > weekEnd;

                var radius = $"{(continuesLeft  ? "0" : "6px")} " +
                             $"{(continuesRight ? "0" : "6px")} " +
                             $"{(continuesRight ? "0" : "6px")} " +
                             $"{(continuesLeft  ? "0" : "6px")}";

                var color = GetJourneyColor(journey.Id);

                <div class="cal-journey-span"
                     style="grid-column: @startCol / span @spanCols;
                            background: @color;
                            border-radius: @radius;
                            @(continuesLeft  ? "margin-left:0;padding-left:4px;" : "")
                            @(continuesRight ? "margin-right:0;padding-right:4px;" : "")"
                     @onclick="() => OnJourneyClick.InvokeAsync(journey)"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDropOnJourney(journey)"
                     @ondrop:stopPropagation="true">

                    <span class="journey-span-country">@journey.Country</span>

                    @if (journey.TravelLeaders != null && journey.TravelLeaders.Any())
                    {
                        <span class="journey-span-leader"> · @journey.TravelLeaders.First().Name</span>
                    }
                </div>
            }
        </div>
    }
</MudPaper>

<style>
    /* ── Nav block: arrow | [title + pills] | arrow ── */
    .cal-nav-block {
        margin-bottom: 12px;
    }
    .cal-nav-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }
    .cal-nav-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 1;
        padding: 4px 0;
    }

    /* ── Month-pill jump bar ── */
    .cal-pills-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }
    .cal-pill-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }
    .cal-month-pill {
        padding: 4px 13px;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        background: #f8fafc;
        font-size: 0.8rem;
        font-weight: 600;
        color: #475569;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .cal-month-pill:hover { background: #e2e8f0; }
    .cal-pill-active {
        background: #1976d2;
        border-color: #1976d2;
        color: #fff;
    }
    .cal-pill-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        padding-left: 4px;
    }
    .cal-journey-chip {
        padding: 2px 8px;
        background: #e0f2fe;
        color: #0369a1;
        border-radius: 10px;
        font-size: 0.73rem;
        cursor: pointer;
        transition: background 0.15s;
    }
    .cal-journey-chip:hover { background: #bae6fd; }

    /* Header row — same 7-column grid as the week rows */
    .cal-header-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        margin-bottom: 2px;
    }
    .cal-header {
        text-align: center;
        font-weight: bold;
        padding: 8px;
        background-color: #f3f4f6;
    }

    /* One week = a 7-column grid.
       Row 1 holds the 7 day-number cells (grid-row: 1 set inline).
       Rows 2+ are filled automatically by journey bars via CSS grid auto-placement. */
    .cal-week {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-auto-rows: auto;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 4px;
    }

    /* Day number cells are always in the first row */
    .cal-day-cell {
        grid-row: 1;
        height: 48px;
        padding: 6px 4px 2px;
        border-right: 1px solid #f0f0f0;
        background: white;
    }
    .cal-day-cell.other-month {
        background: #fafafa;
        color: #bdbdbd;
    }
    .cal-day-cell.today-highlight {
        background: #f0f8ff;
        border-top: 3px solid #1976d2;
    }
    .day-number {
        text-align: right;
        font-size: 0.8em;
    }

    /* Journey bars — span their columns and auto-stack below day cells */
    .cal-journey-span {
        margin: 4px 1px;
        padding: 0 12px;
        font-size: 0.82rem;
        color: white;
        cursor: pointer;
        overflow: hidden;
        white-space: nowrap;
        display: flex;
        align-items: center;
        height: 60px;
        transition: filter 0.15s ease;
    }
    .cal-journey-span:hover {
        filter: brightness(1.12);
    }
    .journey-span-country {
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .journey-span-leader {
        font-size: 0.75rem;
        opacity: 0.88;
        margin-left: 2px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    [Parameter] public IReadOnlyList<JourneyViewModel> Journeys { get; set; } = [];
    [Parameter] public EventCallback<JourneyViewModel> OnJourneyDrop { get; set; }
    [Parameter] public EventCallback<JourneyViewModel> OnJourneyClick { get; set; }
    [Parameter] public DateOnly? JumpToDate { get; set; }

    private DateTime _currentDate = DateTime.Today;
    private List<CalendarDay> _days = new();

    // For visual drop feedback
    private JourneyViewModel? _dragTargetJourney;

    protected override void OnInitialized()
    {
        GenerateCalendar();
    }

    // When JumpToDate changes from the parent, snap the calendar to that month.
    protected override void OnParametersSet()
    {
        if (JumpToDate.HasValue)
        {
            _currentDate = JumpToDate.Value.ToDateTime(TimeOnly.MinValue);
            GenerateCalendar();
        }
    }

    private void PrevMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        GenerateCalendar();
    }

    private void NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        GenerateCalendar();
    }

    private void GoToMonth(DateOnly date)
    {
        _currentDate = date.ToDateTime(TimeOnly.MinValue);
        GenerateCalendar();
    }

    private void GenerateCalendar()
    {
        _days.Clear();
        var firstDayOfMonth = new DateOnly(_currentDate.Year, _currentDate.Month, 1);

        // Start from Monday
        var startDay = firstDayOfMonth;
        while (startDay.DayOfWeek != DayOfWeek.Monday)
            startDay = startDay.AddDays(-1);

        for (int i = 0; i < 42; i++) // 6 weeks
            _days.Add(new CalendarDay { Date = startDay.AddDays(i) });
    }

    private IEnumerable<JourneyViewModel> GetJourneysForDay(DateOnly date)
    {
        return Journeys.Where(j => j.Start <= date && j.End >= date);
    }

    // Monday = col 1 … Sunday = col 7 (matches the CSS grid columns)
    private static int GetDayColumn(DateOnly date)
        => date.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)date.DayOfWeek;

    private static readonly string[] JourneyColors =
    [
        "#1976d2", "#388e3c", "#f57c00", "#7b1fa2",
        "#c62828", "#00796b", "#5d4037", "#0288d1"
    ];

    private static string GetJourneyColor(int journeyId)
        => JourneyColors[Math.Abs(journeyId) % JourneyColors.Length];

    private void HandleDragEnter(JourneyViewModel journey)
    {
        _dragTargetJourney = journey;
    }

    private void HandleDragLeave(JourneyViewModel journey)
    {
        if (_dragTargetJourney == journey)
            _dragTargetJourney = null;
    }

    private bool IsDropTarget(JourneyViewModel journey)
        => _dragTargetJourney == journey;

    private async Task HandleDropOnJourney(JourneyViewModel journey)
    {
        _dragTargetJourney = null;
        if (OnJourneyDrop.HasDelegate)
        {
            await OnJourneyDrop.InvokeAsync(journey);
        }
    }

    private class CalendarDay
    {
        public DateOnly Date { get; set; }
    }
}
