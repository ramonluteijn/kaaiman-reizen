<button type="button"
        class="btn position-absolute h-100 d-flex align-items-center end-0 top-0 border-0 shadow-none"
        @onclick="TogglePasswordVisibility"
        @onclick:preventDefault="true"
        style="z-index: 10; width: 48px; background: transparent; outline: none !important; box-shadow: none !important;">
    <span class="material-icons" style="font-size: 1.25rem; color:grey">visibility</span>
</button>

@code {
    [Parameter]
    public string For { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; }

    private async Task TogglePasswordVisibility()
    {
        await JS.InvokeVoidAsync("togglePasswordVisibility", For);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DefineToggleFunction();
        }
    }

    private ValueTask DefineToggleFunction()
    {
        return JS.InvokeVoidAsync("eval", @"
            window.togglePasswordVisibility = (id) => {
                const el = document.getElementById(id);
                el.type = el.type === 'password' ? 'text' : 'password';
                const btn = el.nextElementSibling;
                if (btn && btn.querySelector('.material-icons')) {
                    btn.querySelector('.material-icons').textContent = el.type === 'password' ? 'visibility' : 'visibility_off';
                }
            };
        ");
    }
}
