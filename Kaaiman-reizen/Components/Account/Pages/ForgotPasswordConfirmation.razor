@page "/Account/ForgotPasswordConfirmation"
@layout AuthLayout

<PageTitle>Wachtwoord herstel bevestiging</PageTitle>

<div class="auth-page-shell container">
    <div class="auth-card-column">
        <div class="card rounded-4 border-0 shadow-lg">
            <div class="card-body p-5 text-center">
                
                @* Logo met extra witruimte onderin *@
                <div class="mb-5 pb-3">
                    <img src="images/Kaaiman-reizen-logo.webp" class="navbar-brand img-fluid auth-logo" alt="Logo Kaaiman-reizen" />
                </div>

                @* Titel en tekst met meer ademruimte *@
                <div class="mb-5 pb-2">
                    <h2 class="h4 fw-bold mb-3">Check je e-mail</h2>
                    <p class="text-muted">
                        We hebben een link naar je inbox gestuurd om je wachtwoord te herstellen.
                    </p>
                </div>

                @* Link terug naar inloggen met duidelijke scheiding en veel spacing *@
                <div class="border-top mt-5 pt-5">
                    <p class="text-muted mt-5">
                        Terug naar <a href="Account/Login" class="text-decoration-none fw-bold text-dark">Inloggen</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>