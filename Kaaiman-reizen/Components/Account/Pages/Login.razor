@page "/Account/Login"
@layout AuthLayout

@using System.ComponentModel.DataAnnotations
@using Kaaiman_reizen.Components.Account
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Kaaiman_reizen.Data.Identity;

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject Kaaiman_reizen.Components.Account.IdentityRedirectManager RedirectManager

<PageTitle>Loginpagina</PageTitle>

<div class="auth-page-shell auth-page-shell--compact container">
    <div class="auth-card-column">
        <div class="card rounded-4 border-0 shadow-lg">
            <div class="card-body p-5">
                
                <img src="images/Kaaiman-reizen-logo.webp" class="navbar-brand img-fluid mb-5 auth-logo" alt="Logo Kaaiman-reizen" />

                <StatusMessage Message="@errorMessage" />

                <EditForm Model="Input" method="post" OnSubmit="LoginUser" FormName="login" class="mt-5">
                    <DataAnnotationsValidator />

                    <div class="form-floating mb-5">
                        <InputText @bind-Value="Input.Email" class="form-control rounded-3" autocomplete="username" />
                        <label>E-mailadres</label>
                        <ValidationMessage For="() => Input.Email" class="text-danger" />
                    </div>

                    <div class="form-floating mb-5">
                        <InputText type="password" @bind-Value="Input.Password" class="form-control rounded-3" autocomplete="current-password" />
                        <label>Wachtwoord</label>
                        <ValidationMessage For="() => Input.Password" class="text-danger" />
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center gap-2 mb-5">
                        <div class="d-flex align-items-center mb-2">
                            <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input m-0" id="rememberMe" />
                            <label class="form-check-label mb-0 ms-2 auth-remember-label" for="rememberMe">
                                Onthoud mij
                            </label>
                        </div>
                        <a href="Account/ForgotPassword" class="text-decoration-none small">Wachtwoord vergeten?</a>
                    </div>

                    <button type="submit" class="w-100 btn btn-dark btn-lg rounded-3 mb-5 mt-5 py-2">Log in</button>
                </EditForm>
                <ExternalLoginPicker />       
                <div class="mt-5 pt-5 text-center">
                    <p class="mb-0">Nog geen account? <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))" class="text-decoration-none fw-bold">Registreer hier</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Verwijder bestaande externe cookie voor een schone login
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser(EditContext editContext)
    {
        // 1. Controleer op Passkey fouten
        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = $"Error: {Input.Passkey.Error}";
            return;
        }

        SignInResult result;

        // 2. Probeer Passkey inlog
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            result = await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson);
        }
        else
        {
            // 3. Probeer Wachtwoord inlog (valideer eerst de velden)
            if (!editContext.Validate())
            {
                return;
            }

            result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);
        }

        // 4. Resultaat afhandeling
        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            errorMessage = "Fout: Ongeldige inlogpoging.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vul een e-mailadres in")]
        [EmailAddress(ErrorMessage = "Dit is geen geldig e-mailadres")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Vul een wachtwoord in")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}